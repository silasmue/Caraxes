vfio_region_write
vfio_pci_read_config
vfio_pci_write_config
vfio_msi_interrupt
vfio_intx_interrupt
vfio_quirk_generic_mirror_*
vfio_quirk_nvidia_*
vfio_pci_reset*
vfio_pci_hot_reset*
vfio_msi_enable
vfio_msi_disable
vfio_msix_enable
vfio_intx_enable
vfio_ioeventfd_init
