+/// `[<cpu_start>:<dma_start>:<size>,...]`, every number decimal or `0x` hex.
+struct DmaRangeList(Vec<DmaRangeConfig>);
+
+impl FromStr for DmaRangeList {
+    type Err = String;
+
+    fn from_str(s: &str) -> result::Result<Self, Self::Err> {
+        fn number(s: &str) -> result::Result<u64, String> {
+            let s = s.trim();
+            match s.strip_prefix("0x").or_else(|| s.strip_prefix("0X")) {
+                Some(hex) => u64::from_str_radix(hex, 16),
+                None => s.parse(),
+            }
+            .map_err(|_| format!("invalid number {s:?}"))
+        }
+
+        s.trim()
+            .trim_start_matches('[')
+            .trim_end_matches(']')
+            .split(',')
+            .map(|entry| {
+                let fields = entry
+                    .split(':')
+                    .map(number)
+                    .collect::<result::Result<Vec<_>, _>>()?;
+                match fields[..] {
+                    [cpu_start, dma_start, size] => Ok(DmaRangeConfig {
+                        cpu_start,
+                        dma_start,
+                        size,
+                    }),
+                    _ => Err(format!("{entry:?} is not <cpu_start>:<dma_start>:<size>")),
+                }
+            })
+            .collect::<result::Result<_, _>>()
+            .map(DmaRangeList)
+    }
+}
