+        let dma_template =
+            aml::ResourceTemplate::new(dma_descriptors.iter().map(|d| d as &dyn Aml).collect());
+        let dma = aml::Name::new("_DMA".into(), &dma_template);
+        if !self.dma_ranges.is_empty() {
