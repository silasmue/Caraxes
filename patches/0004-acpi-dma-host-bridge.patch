+    #[test]
+    // The host bridge carries _DMA only when ranges are configured, as a
+    // buffer of one QWordMemory descriptor per range with _TRA = cpu - dma.
+    fn dma_ranges_emit_dma_object() {
+        let mut segment = setup();
+        let mut aml = Vec::new();
+        segment.to_aml_bytes(&mut aml);
+        assert!(!aml.windows(4).any(|w| w == b"_DMA"));
+
+        segment.set_dma_ranges(&[
+            DmaRangeConfig {
+                cpu_start: 0,
+                dma_start: 0x7ffe_0000_0000,
+                size: 0xc000_0000,
+            },
+            DmaRangeConfig {
+                cpu_start: 0x1_0000_0000,
+                dma_start: 0x7ffd_c000_0000,
+                size: 0x4000_0000,
+            },
+        ]);
+        #[rustfmt::skip]
+        let expected: &[u8] = &[
+            0x08, b'_', b'D', b'M', b'A',       // NameOp "_DMA"
+            0x11, 0x42, 0x06, 0x0a, 0x5e,       // BufferOp, PkgLength 98, size 94
+            // QWordMemory: producer, MinFixed, MaxFixed, Cacheable, ReadWrite
+            0x8a, 0x2b, 0x00, 0x00, 0x0c, 0x03,
+            0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // _GRA
+            0x00, 0x00, 0x00, 0x00, 0xfe, 0x7f, 0x00, 0x00, // _MIN
+            0xff, 0xff, 0xff, 0xbf, 0xfe, 0x7f, 0x00, 0x00, // _MAX
+            0x00, 0x00, 0x00, 0x00, 0x02, 0x80, 0xff, 0xff, // _TRA
+            0x00, 0x00, 0x00, 0xc0, 0x00, 0x00, 0x00, 0x00, // _LEN
+            0x8a, 0x2b, 0x00, 0x00, 0x0c, 0x03,
+            0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // _GRA
+            0x00, 0x00, 0x00, 0xc0, 0xfd, 0x7f, 0x00, 0x00, // _MIN
+            0xff, 0xff, 0xff, 0xff, 0xfd, 0x7f, 0x00, 0x00, // _MAX
+            0x00, 0x00, 0x00, 0x40, 0x03, 0x80, 0xff, 0xff, // _TRA
+            0x00, 0x00, 0x00, 0x40, 0x00, 0x00, 0x00, 0x00, // _LEN
+            0x79, 0x00,                         // EndTag
+        ];
+        let mut aml = Vec::new();
+        segment.to_aml_bytes(&mut aml);
+        assert_eq!(
+            aml.windows(expected.len())
+                .filter(|w| *w == expected)
+                .count(),
+            1
+        );
+    }
 }
