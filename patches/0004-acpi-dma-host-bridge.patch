+        // Each range must be translatable in both directions without
+        // ambiguity: non-empty, page aligned, no wrap, and disjoint from
+        // every other range on the CPU side and on the bus side.
+        let ranges = self.dma_ranges.as_deref().unwrap_or_default();
+        let last = |start: u64, size: u64| start.checked_add(size - 1);
+        for (i, r) in ranges.iter().enumerate() {
+            if r.size == 0
+                || (r.cpu_start | r.dma_start | r.size) & 0xfff != 0
+                || last(r.cpu_start, r.size).is_none()
+                || last(r.dma_start, r.size).is_none()
+            {
+                return Err(ValidationError::InvalidPciSegmentDmaRange(
+                    self.pci_segment,
+                    i,
+                ));
+            }
+        }
+        let overlap = |a: u64, b: u64, size_a: u64, size_b: u64| {
+            a <= b + (size_b - 1) && b <= a + (size_a - 1)
+        };
+        for (i, a) in ranges.iter().enumerate() {
+            for (j, b) in ranges.iter().enumerate().skip(i + 1) {
+                if overlap(a.cpu_start, b.cpu_start, a.size, b.size)
+                    || overlap(a.dma_start, b.dma_start, a.size, b.size)
+                {
+                    return Err(ValidationError::OverlappingPciSegmentDmaRanges(
+                        self.pci_segment,
+                        i,
+                        j,
+                    ));
+                }
+            }
+        }
+
         Ok(())
     }
 }
