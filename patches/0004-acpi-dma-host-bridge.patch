+    /// Sets the ranges reported in this segment's `_DMA` object. The config
+    /// has already been validated; this only warns about bus-side ranges
+    /// that fall into the segment's own MMIO windows, because ACPI treats
+    /// such child-side accesses as peer-to-peer and not as memory accesses.
+    pub(crate) fn set_dma_ranges(&mut self, dma_ranges: &[DmaRangeConfig]) {
+        for r in dma_ranges {
+            let dma_end = r.dma_start + (r.size - 1);
+            for (start, end) in [
+                (self.start_of_mem32_area, self.end_of_mem32_area),
+                (self.start_of_mem64_area, self.end_of_mem64_area),
+            ] {
+                if r.dma_start <= end && start <= dma_end {
+                    warn!(
+                        "PCI segment {}: DMA range [0x{:x}-0x{:x}] overlaps the MMIO window [0x{:x}-0x{:x}]",
+                        self.id, r.dma_start, dma_end, start, end
+                    );
+                }
+            }
+        }
+        self.dma_ranges = dma_ranges.to_vec();
+    }
