diff --git a/vfio-user/src/lib.rs b/vfio-user/src/lib.rs
index aab99d8..baab79e 100644
--- a/vfio-user/src/lib.rs
+++ b/vfio-user/src/lib.rs
@@ -11,12 +11,14 @@ use std::fs::File;
 use std::io::{IoSlice, Read, Write};
