From 2d9de4f361d7cc146ff3b31468e1f71a38d8645e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Silas=20M=C3=BCller?= <github@silasmueller.de>
Date: Tue, 29 Sep 2026 14:42:24 +0200
Subject: [PATCH] pci: vfio-user: keep read-only mmap areas read-only across
 BAR moves

move_bar() removed each user memory region with its read-only flag but
re-created it at the new base as writable. A guest whose firmware
reassigns the BAR (EDK2 moves every BAR at boot) thus lost the
read-only areas configured with x_readonly_mmap_areas: its writes to
them landed in the shared mapping instead of trapping to the vfio-user
region protocol. Re-create the region with the flag it had.
---
 pci/src/vfio_user.rs | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/pci/src/vfio_user.rs b/pci/src/vfio_user.rs
index 02e2b9b92..3aa2cab27 100644
--- a/pci/src/vfio_user.rs
+++ b/pci/src/vfio_user.rs
@@ -910,7 +910,8 @@ impl PciDevice for VfioUserPciDevice {
                         user_memory_region.start -= old_base - new_base;
                     }
 
-                    // Insert new region
+                    // Insert new region, with the access it had: a read-only area stays
+                    // read-only at the new base.
                     // SAFETY: only valid regions are in user_memory_regions
                     unsafe {
                         self.vm.create_user_memory_region(
@@ -918,7 +919,7 @@ impl PciDevice for VfioUserPciDevice {
                             user_memory_region.start,
                             user_memory_region.mapping.len(),
                             user_memory_region.mapping.addr(),
-                            false,
+                            user_memory_region.readonly,
                             false,
                         )
                     }
