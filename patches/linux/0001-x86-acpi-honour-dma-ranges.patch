 drivers/acpi/x86/dma.c | 44 ++++++++++++++++++++++++++++++++++++++++++
 include/linux/acpi.h   |  2 +-
 3 files changed, 46 insertions(+), 1 deletion(-)
 create mode 100644 drivers/acpi/x86/dma.c

diff --git a/drivers/acpi/Makefile b/drivers/acpi/Makefile
index 12ef8180d..b6acb6617 100644
--- a/drivers/acpi/Makefile
+++ b/drivers/acpi/Makefile
@@ -59,6 +59,7 @@ acpi-$(CONFIG_X86)		+= acpi_cmos_rtc.o
 acpi-$(CONFIG_X86)		+= x86/apple.o
 acpi-$(CONFIG_X86)		+= x86/utils.o
 acpi-$(CONFIG_X86)		+= x86/s2idle.o
+acpi-$(CONFIG_X86)		+= x86/dma.o
 acpi-$(CONFIG_DEBUG_FS)		+= debugfs.o
 acpi-y				+= acpi_lpat.o
 acpi-$(CONFIG_ACPI_FPDT)	+= acpi_fpdt.o
diff --git a/drivers/acpi/x86/dma.c b/drivers/acpi/x86/dma.c
new file mode 100644
index 000000000..8b9852de7
--- /dev/null
+++ b/drivers/acpi/x86/dma.c
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Honour the ACPI _DMA object on x86.
+ *
+ * A bus device (typically a PCI host bridge) may describe in _DMA the
+ * child-side address ranges it forwards to memory and the offset it adds
+ * to them (ACPI 6.5, sections 6.2.4 and 6.4.3.5). acpi_dma_get_range()
+ * turns that into a bus_dma_region table; installing it as the device's
+ * dma_range_map makes dma-direct (and swiotlb) hand out translated DMA
+ * addresses, exactly as on arm64 and LoongArch.
+ */
+#include <linux/acpi.h>
+#include <linux/device.h>
+#include <linux/dma-direct.h>
+
+void acpi_arch_dma_setup(struct device *dev)
+{
+	const struct bus_dma_region *map = NULL, *r;
+	u64 end = 0, mask;
+
+	if (dev->dma_range_map) {
+		dev_dbg(dev, "dma_range_map already set\n");
+		return;
+	}
+
+	/* -ENODEV: no _DMA above this device, the common case on x86. */
+	if (acpi_dma_get_range(dev, &map) || !map)
+		return;
+
+	for (r = map; r->size; r++)
+		end = max_t(u64, end, r->dma_start + r->size - 1);
+
+	dev->dma_range_map = map;
+	dev->bus_dma_limit = end;
+
+	/* Limit the default masks as arm64 and LoongArch do. */
+	mask = DMA_BIT_MASK(ilog2(end) + 1);
+	dev->coherent_dma_mask = min(dev->coherent_dma_mask, mask);
+	if (dev->dma_mask)
+		*dev->dma_mask = min(*dev->dma_mask, mask);
+
+	dev_dbg(dev, "ACPI _DMA: %td range(s), bus limit %#llx\n",
+		r - map, end);
+}
diff --git a/include/linux/acpi.h b/include/linux/acpi.h
index 4cc509fe3..a76aa9d37 100644
--- a/include/linux/acpi.h
+++ b/include/linux/acpi.h
@@ -254,7 +254,7 @@ acpi_numa_processor_affinity_init(struct acpi_srat_cpu_affinity *pa) { }
 
 void acpi_numa_x2apic_affinity_init(struct acpi_srat_x2apic_cpu_affinity *pa);
 
-#if defined(CONFIG_ARM64) || defined(CONFIG_LOONGARCH)
+#if defined(CONFIG_ARM64) || defined(CONFIG_LOONGARCH) || defined(CONFIG_X86)
 void acpi_arch_dma_setup(struct device *dev);
 #else
 static inline void acpi_arch_dma_setup(struct device *dev) { }
