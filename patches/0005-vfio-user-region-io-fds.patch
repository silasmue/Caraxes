+
+    /// Ask the server for each BAR's region I/O fds
+    /// (VFIO_USER_DEVICE_GET_REGION_IO_FDS) and register the ioeventfds it
+    /// offers, so that guest writes there signal the server without exiting to
+    /// the VMM. A server that refuses the request keeps every access trapped.
+    fn map_region_io_fds(&mut self) -> Result<(), VfioUserPciDeviceError> {
+        for i in 0..self.common.mmio_regions.len() {
+            let region = &self.common.mmio_regions[i];
+            let index = region.index;
+            let start = region.start.raw_value();
+            let length = region.length;
+            let io_region = region.type_ == PciBarRegionType::IoRegion;
+            let mapped: Vec<(u64, u64)> = region
+                .user_memory_regions
+                .iter()
+                .map(|r| (r.start - start, r.mapping.len() as u64))
+                .collect();
+
+            let result = self.client.lock().unwrap().get_region_io_fds(index);
+            let reply = match region_io_fds_outcome(result)
+                .map_err(VfioUserPciDeviceError::RegionIoFds)?
+            {
+                RegionIoFdsOutcome::Reply(reply) => reply,
+                RegionIoFdsOutcome::Refused(why) => {
+                    warn!(
+                        "{}: region {index}: region I/O fds reply not in the vfio-user specification's form ({why}); the region stays trapped",
+                        self.id
+                    );
+                    continue;
+                }
