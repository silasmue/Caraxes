+
+    /// Whether `[offset, offset + len)` of BAR `bar_index` overlaps the MSI-X
+    /// table or the PBA, which the VMM emulates and must keep trapping.
+    pub(crate) fn overlaps(&self, bar_index: u32, offset: u64, len: u64) -> bool {
+        let hit = |bir: u32, (start, size): (u64, u64)| {
+            bir == bar_index && offset < start + size && start < offset + len
+        };
+        hit(self.cap.table_bir(), self.cap.table_range())
+            || hit(self.cap.pba_bir(), self.cap.pba_range())
+    }
 }
 
