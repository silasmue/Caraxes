+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn ioeventfd(
+        offset: u64,
+        size: u64,
+        fd_index: u32,
+        flags: u32,
+        datamatch: u64,
+    ) -> SubRegionIoFd {
+        SubRegionIoFd::IoEventFd {
+            offset,
+            size,
+            fd_index,
+            flags,
+            datamatch,
+        }
+    }
+
+    // A 16 MiB memory BAR, one descriptor received, nothing mapped.
+    fn check(sub_region: &SubRegionIoFd) -> Result<IoEventFdSpec, String> {
+        check_sub_region(sub_region, 1, 0x100_0000, false, |_, _| false)
+    }
+
+    #[test]
+    fn sub_region_is_used_as_offered() {
+        assert_eq!(
+            check(&ioeventfd(0xbb_0090, 4, 0, 0, 0)),
+            Ok(IoEventFdSpec {
+                offset: 0xbb_0090,
+                len: 4,
+                datamatch: None,
+                pio: false,
+                fd_index: 0,
+            })
+        );
+        assert_eq!(
+            check(&ioeventfd(0x90, 2, 0, IOEVENTFD_FLAG_DATAMATCH, 0xffff)),
+            Ok(IoEventFdSpec {
+                offset: 0x90,
+                len: 2,
+                datamatch: Some(0xffff),
+                pio: false,
+                fd_index: 0,
+            })
+        );
+        // Without the flag the datamatch field is not used; size 0 is any size.
+        assert_eq!(
+            check(&ioeventfd(0x90, 0, 0, 0, 0x1234)).unwrap().datamatch,
+            None
+        );
+        assert_eq!(
+            check(&ioeventfd(
+                0xff_fff8,
+                8,
+                0,
+                IOEVENTFD_FLAG_DATAMATCH,
+                u64::MAX
+            ))
+            .unwrap()
+            .len,
+            8
+        );
+        // PIO on an I/O port BAR.
+        assert!(
+            check_sub_region(
+                &ioeventfd(4, 1, 0, IOEVENTFD_FLAG_PIO, 0),
+                1,
+                0x100,
+                true,
+                |_, _| false
+            )
+            .unwrap()
+            .pio
+        );
+    }
+
+    #[test]
+    fn sub_region_is_refused() {
+        let refused = [
+            (
+                SubRegionIoFd::IoRegionFd {
+                    offset: 0,
+                    size: 4,
+                    fd_index: 0,
+                    flags: 0,
+                    user_data: 0,
+                },
+                "ioregionfd",
+            ),
+            // KVM_IOEVENTFD_FLAG_DEASSIGN is not a sub-region flag.
+            (ioeventfd(0, 4, 0, 1 << 2, 0), "flags 0x4"),
+            (
+                ioeventfd(0, 4, 0, IOEVENTFD_FLAG_VIRTIO_CCW_NOTIFY, 0),
+                "VIRTIO_CCW_NOTIFY",
+            ),
+            (ioeventfd(0, 4, 0, IOEVENTFD_FLAG_PIO, 0), "PIO flag set"),
+            (ioeventfd(0, 3, 0, 0, 0), "size 3"),
+            (ioeventfd(0, 0x1000, 0, 0, 0), "size 4096"),
+            (
+                ioeventfd(0, 0, 0, IOEVENTFD_FLAG_DATAMATCH, 0),
+                "datamatch with size 0",
+            ),
+            (
+                ioeventfd(0, 2, 0, IOEVENTFD_FLAG_DATAMATCH, 0x1_0000),
+                "wider than 2 bytes",
+            ),
+            (ioeventfd(0, 4, 1, 0, 0), "fd_index 1"),
+            // libvfio-user's index for a sub-region without a descriptor.
+            (ioeventfd(0, 4, u32::MAX, 0, 0), "fd_index 4294967295"),
+            (ioeventfd(0xff_fffe, 4, 0, 0, 0), "outside"),
+            (ioeventfd(0x100_0000, 0, 0, 0, 0), "outside"),
+            (ioeventfd(u64::MAX, 8, 0, 0, 0), "outside"),
+        ];
+        for (sub_region, why) in refused {
+            let e = check(&sub_region).unwrap_err();
+            assert!(e.contains(why), "{e:?} does not say {why:?}");
+        }
+
+        // A range the VMM must keep trapping (mapped, or MSI-X).
+        let trapped = |offset: u64, len: u64| offset < 0x3000 && 0x2000 < offset + len;
+        let at =
+            |offset| check_sub_region(&ioeventfd(offset, 4, 0, 0, 0), 1, 0x1_0000, false, trapped);
+        assert!(at(0x1ffe).unwrap_err().contains("overlaps"));
+        assert!(at(0x2ffc).unwrap_err().contains("overlaps"));
+        at(0x1ffc).unwrap();
+        at(0x3000).unwrap();
+    }
+
+    /// A reply payload, byte by byte per vfio-user.rst,
+    /// "VFIO_USER_DEVICE_GET_REGION_IO_FDS", "Reply": argsz 0, flags 4, index 8,
+    /// count 12, sub-regions from 16.
+    fn reply(argsz: u32, count: u32, entries: &[u8]) -> Vec<u8> {
+        let mut payload = Vec::new();
+        for field in [argsz, 0, 0, count] {
+            payload.extend_from_slice(&field.to_ne_bytes());
+        }
+        payload.extend_from_slice(entries);
+        payload
+    }
+
+    #[test]
+    fn reply_in_the_specification_layout_is_used() {
+        // "Sub-Region IO FD info format (ioeventfd)": offset 0, size 8, fd_index
+        // 16, type 20, flags 24, padding 28, datamatch 32; 40 bytes.
+        let mut entry = [0u8; 40];
+        entry[0..8].copy_from_slice(&0xbb_0090u64.to_ne_bytes());
+        entry[8..16].copy_from_slice(&4u64.to_ne_bytes());
+        entry[24..28].copy_from_slice(&IOEVENTFD_FLAG_DATAMATCH.to_ne_bytes());
+        entry[32..40].copy_from_slice(&7u64.to_ne_bytes());
+        let parsed = vfio_user::parse_region_io_fds_reply(656, 0, &reply(56, 1, &entry));
+        let Ok(vfio_user::RegionIoFdsReply::Complete { sub_regions }) = parsed else {
+            panic!("{parsed:?}");
+        };
+        assert_eq!(
+            check(&sub_regions[0]),
+            Ok(IoEventFdSpec {
+                offset: 0xbb_0090,
+                len: 4,
+                datamatch: Some(7),
+                pio: false,
+                fd_index: 0,
+            })
+        );
+    }
+
+    /// libvfio-user (include/vfio-user.h:178-187 at 803924493a7c) sends 48-byte
+    /// ioeventfd entries: gpa_offset 0, size 8, fd_index 16, type 20, flags 24,
+    /// shadow_mem_fd_index 28, shadow_offset 32, datamatch 40. The reply is
+    /// refused and the region stays trapped; no ioeventfd is registered.
+    #[test]
+    fn libvfio_user_reply_keeps_the_region_trapped() {
+        let mut entry = [0u8; 48];
+        entry[0..8].copy_from_slice(&0xbb_0090u64.to_ne_bytes());
+        entry[8..16].copy_from_slice(&4u64.to_ne_bytes());
+        entry[24..28].copy_from_slice(&IOEVENTFD_FLAG_DATAMATCH.to_ne_bytes());
+        entry[40..48].copy_from_slice(&7u64.to_ne_bytes());
+        let parsed = vfio_user::parse_region_io_fds_reply(656, 0, &reply(64, 1, &entry));
+        let result = parsed.map(|_| -> RegionIoFds { panic!("accepted a 48-byte entry") });
+        assert!(matches!(
+            region_io_fds_outcome(result),
+            Ok(RegionIoFdsOutcome::Refused(_))
+        ));
+
+        // An error reply means the server has none: stop asking.
+        assert!(matches!(
+            region_io_fds_outcome(Err(VfioUserError::ErrorReply {
+                command: vfio_user::Command::GetRegionIoFds,
+                errno: 0,
+            })),
+            Ok(RegionIoFdsOutcome::Unsupported(0))
+        ));
+    }
