@@ -41,6 +44,178 @@ pub struct VfioUserPciDevice {
     client: Arc<Mutex<Client>>,
     common: VfioCommon,
     memory_slot_allocator: MemorySlotAllocator,
+    region_io_eventfds: Vec<RegionIoEventFd>,
+}
+
+/// An ioeventfd sub-region that passed [`check_sub_region`]. The fields come from
+/// the vfio-user specification (vfio-user.rst, QEMU docs/interop/vfio-user.rst),
+/// "Sub-Region IO FD info format (ioeventfd)".
+#[derive(Debug, PartialEq, Eq)]
+struct IoEventFdSpec {
+    /// offset (entry offset 0): start of the sub-region within the region.
+    offset: u64,
+    /// size (entry offset 8), used as KVM_IOEVENTFD `len`: 0 (any access size),
+    /// 1, 2, 4 or 8.
+    len: u32,
+    /// datamatch (entry offset 32), when flags (entry offset 24) has
+    /// KVM_IOEVENTFD_FLAG_DATAMATCH.
+    datamatch: Option<u64>,
+    /// flags (entry offset 24) has KVM_IOEVENTFD_FLAG_PIO.
+    pio: bool,
+    /// fd_index (entry offset 16): the descriptor in the reply's ancillary data.
+    fd_index: u32,
+}
+
+/// An ioeventfd the server offered with VFIO_USER_DEVICE_GET_REGION_IO_FDS, as
+/// registered with the hypervisor.
+struct RegionIoEventFd {
+    /// Region (BAR) index.
+    index: u32,
+    spec: IoEventFdSpec,
+    /// The eventfd; sub-regions that name the same fd_index share it.
+    event: Arc<EventFd>,
+    /// Guest address of the sub-region.
+    addr: u64,
+}
+
+impl RegionIoEventFd {
+    fn io_addr(&self) -> IoEventAddress {
+        if self.spec.pio {
+            IoEventAddress::Pio(self.addr)
+        } else {
+            IoEventAddress::Mmio(self.addr)
+        }
+    }
+
+    fn register(&self, vm: &dyn hypervisor::Vm) -> Result<(), HypervisorVmError> {
+        vm.register_ioevent_exact(
+            &self.event,
+            &self.io_addr(),
+            self.spec.len,
+            self.spec.datamatch,
+        )
+    }
+
+    fn unregister(&self, vm: &dyn hypervisor::Vm) -> Result<(), HypervisorVmError> {
+        vm.unregister_ioevent_exact(
+            &self.event,
+            &self.io_addr(),
+            self.spec.len,
+            self.spec.datamatch,
+        )
+    }
+}
+
+/// What a VFIO_USER_DEVICE_GET_REGION_IO_FDS request for one region gave.
+#[derive(Debug)]
+enum RegionIoFdsOutcome {
+    /// A reply in the specification's form.
+    Reply(RegionIoFds),
+    /// A reply not in the specification's form (for example libvfio-user's
+    /// 48-byte ioeventfd entries): the region stays trapped.
+    Refused(&'static str),
+    /// An error reply: the server does not provide region I/O fds.
+    Unsupported(u32),
+}
+
+fn region_io_fds_outcome(
+    result: Result<RegionIoFds, VfioUserError>,
+) -> Result<RegionIoFdsOutcome, VfioUserError> {
+    match result {
+        Ok(reply) => Ok(RegionIoFdsOutcome::Reply(reply)),
+        Err(VfioUserError::InvalidReply(_, why)) => Ok(RegionIoFdsOutcome::Refused(why)),
+        Err(VfioUserError::ErrorReply { errno, .. }) => Ok(RegionIoFdsOutcome::Unsupported(errno)),
+        Err(e) => Err(e),
+    }
+}
+
+/// Check a sub-region the server offered for a region of `region_size` bytes (an
+/// I/O port BAR if `io_region`), received with `fds` descriptors. vfio-user.rst,
+/// "VFIO_USER_DEVICE_GET_REGION_IO_FDS", leaves this to the client ("it is the
+/// client's responsibility to verify the requested values"); the size and
+/// datamatch rules are those of KVM_IOEVENTFD, to which "Sub-Region IO FD info
+/// format (ioeventfd)" refers. `must_trap(offset, len)` says whether the VMM must
+/// keep seeing accesses to a range.
+fn check_sub_region(
+    sub_region: &SubRegionIoFd,
+    fds: usize,
+    region_size: u64,
+    io_region: bool,
+    must_trap: impl Fn(u64, u64) -> bool,
+) -> Result<IoEventFdSpec, String> {
+    let (offset, size, fd_index, flags, datamatch) = match *sub_region {
+        SubRegionIoFd::IoEventFd {
+            offset,
+            size,
+            fd_index,
+            flags,
+            datamatch,
+        } => (offset, size, fd_index, flags, datamatch),
+        // "Sub-Region IO FD info format (ioregionfd)" needs KVM ioregionfd, which
+        // is not in Linux.
+        SubRegionIoFd::IoRegionFd { offset, .. } => {
+            return Err(format!(
+                "ioregionfd at {offset:#x}: not supported (KVM has no ioregionfd)"
+            ));
+        }
+    };
+    // "flags is any of" DATAMATCH, PIO, VIRTIO_CCW_NOTIFY.
+    let known = IOEVENTFD_FLAG_DATAMATCH | IOEVENTFD_FLAG_PIO | IOEVENTFD_FLAG_VIRTIO_CCW_NOTIFY;
+    if flags & !known != 0 {
+        return Err(format!("flags {flags:#x}: not the specification's"));
+    }
+    // KVM_IOEVENTFD_FLAG_VIRTIO_CCW_NOTIFY is for s390 subchannels.
+    if flags & IOEVENTFD_FLAG_VIRTIO_CCW_NOTIFY != 0 {
+        return Err("VIRTIO_CCW_NOTIFY: s390 only".into());
+    }
+    let pio = flags & IOEVENTFD_FLAG_PIO != 0;
+    if pio != io_region {
+        return Err(format!(
+            "PIO flag {} for {} BAR",
+            if pio { "set" } else { "clear" },
+            if io_region { "an I/O port" } else { "a memory" }
+        ));
+    }
+    // KVM_IOEVENTFD: "len" of 0, 1, 2, 4 or 8; "size ... may be zero if the
+    // access size is not relevant".
+    let len = match size {
+        0 | 1 | 2 | 4 | 8 => size as u32,
+        _ => return Err(format!("size {size}: KVM takes 0, 1, 2, 4 or 8")),
+    };
+    let datamatch = if flags & IOEVENTFD_FLAG_DATAMATCH != 0 {
+        if len == 0 {
+            return Err("datamatch with size 0".into());
+        }
+        if len < 8 && datamatch >> (8 * len) != 0 {
+            return Err(format!("datamatch {datamatch:#x} wider than {len} bytes"));
+        }
+        Some(datamatch)
+    } else {
+        None
+    };
+    // "fd_index is the index in the ancillary data of the FD".
+    if fd_index as usize >= fds {
+        return Err(format!("fd_index {fd_index} with {fds} descriptor(s)"));
+    }
+    // "the requested offset does not exceed the region's bounds".
+    let end = offset
+        .checked_add(size.max(1))
+        .filter(|&end| end <= region_size)
+        .ok_or_else(|| {
+            format!("{offset:#x}+{size:#x} outside the region of {region_size:#x} bytes")
+        })?;
+    if must_trap(offset, end - offset) {
+        return Err(format!(
+            "{offset:#x}+{size:#x} overlaps a mapped area or the MSI-X table or PBA"
+        ));
+    }
+    Ok(IoEventFdSpec {
+        offset,
+        len,
+        datamatch,
+        pio,
+        fd_index,
+    })
 }
 
