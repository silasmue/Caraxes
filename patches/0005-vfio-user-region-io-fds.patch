 impl KvmVm {
+    /// KVM_IOEVENTFD with `len` and `datamatch` as given (Documentation/virt/kvm/api.rst,
+    /// "KVM_IOEVENTFD"). A deassign must repeat the arguments of the assign.
+    fn ioeventfd(
+        &self,
+        fd: &EventFd,
+        addr: &IoEventAddress,
+        len: u32,
+        datamatch: Option<u64>,
+        deassign: bool,
+    ) -> io::Result<()> {
+        let mut flags = 0;
+        if datamatch.is_some() {
+            flags |= 1 << kvm_bindings::kvm_ioeventfd_flag_nr_datamatch;
+        }
+        if deassign {
+            flags |= 1 << kvm_bindings::kvm_ioeventfd_flag_nr_deassign;
+        }
+        let addr = match *addr {
+            IoEventAddress::Pio(pio) => {
+                flags |= 1 << kvm_bindings::kvm_ioeventfd_flag_nr_pio;
+                pio
+            }
+            IoEventAddress::Mmio(mmio) => mmio,
+        };
+        let ioeventfd = kvm_bindings::kvm_ioeventfd {
+            datamatch: datamatch.unwrap_or(0),
+            addr,
+            len,
+            fd: fd.as_raw_fd(),
+            flags,
+            ..Default::default()
+        };
+        // SAFETY: the fd is a VM fd and `ioeventfd` a valid kvm_ioeventfd, which the
+        // kernel only reads; the result is checked.
+        let ret = unsafe { ioctl_with_ref(&*self.fd, KVM_IOEVENTFD(), &ioeventfd) };
+        if ret == 0 {
+            Ok(())
+        } else {
+            Err(io::Error::last_os_error())
+        }
+    }
+
     ///
     /// Creates an emulated device in the kernel.
     ///
@@ -1003,6 +1055,35 @@ impl vm::Vm for KvmVm {
             .map_err(|e| vm::HypervisorVmError::UnregisterIoEvent(e.into()))
     }
 
+    ///
+    /// Registers an event for writes of exactly `len` bytes at `addr`, optionally
+    /// only for writes of `datamatch`.
+    ///
+    fn register_ioevent_exact(
+        &self,
+        fd: &EventFd,
+        addr: &IoEventAddress,
+        len: u32,
+        datamatch: Option<u64>,
+    ) -> vm::Result<()> {
+        self.ioeventfd(fd, addr, len, datamatch, false)
+            .map_err(|e| vm::HypervisorVmError::RegisterIoEvent(e.into()))
+    }
+
+    ///
+    /// Unregisters an event registered with `register_ioevent_exact`.
+    ///
+    fn unregister_ioevent_exact(
+        &self,
+        fd: &EventFd,
+        addr: &IoEventAddress,
+        len: u32,
+        datamatch: Option<u64>,
+    ) -> vm::Result<()> {
+        self.ioeventfd(fd, addr, len, datamatch, true)
+            .map_err(|e| vm::HypervisorVmError::UnregisterIoEvent(e.into()))
+    }
+
     ///
     /// Constructs a routing entry
     ///
