+                             const NV_MEMORY_ALLOCATION_PARAMS *pAllocData);
+void   displayReserveNoteAlloc(OBJGPU *pGpu, NvHandle hClient,
+                               const NV_MEMORY_ALLOCATION_PARAMS *pAllocData,
+                               Memory *pMemory, NvBool bServed);
+void   displayReserveNoteFree(OBJGPU *pGpu, NvHandle hClient, Memory *pMemory);
+
