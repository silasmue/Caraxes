+
+//
+// Display reserve.
+//
+// A display allocation of a kernel client (NVKMS) has no fallback: a scanout
+// surface must be contiguous video memory, and a refusal leaves the display
+// without a buffer.  Processes that size themselves to the free video memory
+// (a game sizing its pools to the Vulkan memory budget) leave nothing for it.
+//
+// The display reserve holds video memory for these allocations.  It is a set
+// of chunks allocated on the MemoryManager's internal client with the
+// attributes NVKMS uses for a scanout surface, so the reserve counts as used
+// memory and each chunk, once freed, leaves room of the shape such a surface
+// needs.  When a display allocation of a kernel client fails for lack of
+// memory, vidmemConstruct frees chunks and retries the same allocation within
+// the same call.  Every RM allocation holds the API lock for writing unless
+// RmRoApiLock enables read-only allocations, so no other allocation can take
+// the freed memory between the free and the retry.
+//
+// The reserve is sized and cut from the display surfaces that exist: video
+// memory allocated with ISO bandwidth guarantees and without NO_SCANOUT, by
+// any client.  The largest of them is one scanout surface of the largest mode
+// in use (a compositor allocates its framebuffers itself, NVKMS allocates the
+// buffers of GEM objects), so the reserve follows mode changes and hotplug
+// without knowing the modes.  It holds five such surfaces and four 256x256
+// cursors, or RmDisplayReserveSizeMB cut into such surfaces, and nothing
+// while no display surface exists.
+//
+// The reserve refills when a surface it made room for is freed, and otherwise
+// retries on a backoff while it holds less than its size.  Each refill cuts it
+// for the largest display surface at that time; a surface larger than the
+// current cut starts a refill at once, a smaller one waits for the next.
+//
+// Locking: g_pDisplayReserve[] entries change only in StateInitLocked and
+// StateDestroy.  Fill runs as a work item with the API lock held for writing,
+// and displayReserveStart()/displayReserveStop() run from the GPU state
+// transitions, so both exclude every other user of a reserve.  pMutex orders
+// the tracking of display surfaces, which runs from allocation and free, and
+// the release of chunks when RmRoApiLock enables read-only allocations; no
+// other lock is acquired while it is held.
+//
+
+#include "mem_mgr/display_reserve.h"
+#include "gpu/gpu.h"
+#include "gpu/mem_mgr/mem_mgr.h"
+#include "gpu/mem_mgr/heap.h"
+#include "gpu/timer/objtmr.h"
+#include "core/locks.h"
+#include "os/os.h"
+#include "rmapi/rmapi.h"
+#include "containers/map.h"
+#include "nvrm_registry.h"
+#include "class/cl0040.h" // NV01_MEMORY_LOCAL_USER
+
+//
+// The reserve is cut into full chunks of one scanout surface and one rest
+// chunk.  More chunks than this make the full chunk grow past one surface.
+//
+#define DISPLAY_RESERVE_MAX_CHUNKS          64
+#define DISPLAY_RESERVE_CHUNK_ALIGN         0x10000ULL
+
+//
+// Automatic size: five scanout surfaces plus four 256x256 32bpp cursors.
+// The largest peak of display allocations above an idle desktop measured
+// with GNOME 46 on one head was 4.67 scanout surfaces.
+//
+#define DISPLAY_RESERVE_AUTO_SCANOUTS       5
+#define DISPLAY_RESERVE_AUTO_CURSOR_BYTES   (4ULL * 256 * 256 * 4)
+
+#define DISPLAY_RESERVE_BACKOFF_MIN_NS      (1ULL * 1000 * 1000 * 1000)
+#define DISPLAY_RESERVE_BACKOFF_MAX_NS      (30ULL * 1000 * 1000 * 1000)
+
+// NVKMS's surface alignment (NV_EVO_SURFACE_ALIGNMENT)
+#define DISPLAY_RESERVE_SURFACE_ALIGNMENT   0x1000
+
+typedef struct DisplaySurface
+{
+    NvU64   size;
+    NvBool  bServed;    // the reserve made room for it
+} DisplaySurface;
+
+// Live display surfaces, keyed by their Memory object.
+MAKE_MAP(DisplaySurfaceMap, DisplaySurface);
+
+typedef struct DisplayReserve
+{
+    PORT_MUTEX             *pMutex;
+    TMR_EVENT              *pRefillEvent;
+
+    NvU64                   sizeOverride;   // RmDisplayReserveSizeMB, 0: automatic
+
+    DisplaySurfaceMap       surfaces;
+
+    // The current cut, for scanoutSize: numFullChunks x chunkSize + restSize bytes.
+    NvU64                   scanoutSize;
+    NvU64                   size;
+    NvU64                   chunkSize;
+    NvU32                   numFullChunks;
+    NvU64                   restSize;
+
+    // hChunk[i] is 0 while chunk i is not held; index numFullChunks is the rest.
+    NvHandle                hChunk[DISPLAY_RESERVE_MAX_CHUNKS + 1];
+    NvU64                   heldSize;
+
+    NvU64                   backoffNs;
+    NvBool                  bStarted;
+} DisplayReserve;
+
+static DisplayReserve *g_pDisplayReserve[NV_MAX_DEVICES];
+
+static DisplayReserve *
+_displayReserveGet(OBJGPU *pGpu)
+{
+    return (pGpu->gpuInstance < NV_MAX_DEVICES) ? g_pDisplayReserve[pGpu->gpuInstance] : NULL;
+}
+
+static NvU64
+_displayReserveChunkSize(DisplayReserve *pReserve, NvU32 i)
+{
+    return (i < pReserve->numFullChunks) ? pReserve->chunkSize : pReserve->restSize;
+}
+
+//
+// A display surface is video memory with ISO bandwidth guarantees and without
+// NO_SCANOUT.  The reserve's own chunks, allocated on the MemoryManager's
+// internal client, are not.
+//
+static NvBool
+_displayReserveIsDisplaySurface
+(
+    OBJGPU                            *pGpu,
+    NvHandle                           hClient,
+    const NV_MEMORY_ALLOCATION_PARAMS *pAllocData
+)
+{
+    MemoryManager *pMemoryManager = GPU_GET_MEMORY_MANAGER(pGpu);
+
+    return (hClient != pMemoryManager->hClient) &&
+           FLD_TEST_DRF(OS32, _ATTR2, _ISO, _YES, pAllocData->attr2) &&
+           ((pAllocData->flags & NVOS32_ALLOC_FLAGS_NO_SCANOUT) == 0);
+}
+
+static void
+_displayReserveFillWorkItem(NvU32 gpuInstance, void *pArgs);
+
+static void
+_displayReserveQueueFill(OBJGPU *pGpu)
+{
+    NV_STATUS status;
+
+    status = osQueueWorkItem(pGpu, _displayReserveFillWorkItem, NULL,
+                             (OsQueueWorkItemFlags){
+                                 .bDontFreeParams = NV_TRUE,
+                                 .bDropOnUnloadQueueFlush = NV_TRUE,
+                                 .apiLock = WORKITEM_FLAGS_API_LOCK_READ_WRITE});
+    if (status != NV_OK)
+    {
+        NV_PRINTF(LEVEL_ERROR, "display reserve: failed to queue refill (0x%x)\n",
+                  status);
+    }
+}
+
+static NV_STATUS
+_displayReserveRefillCallback(OBJGPU *pGpu, OBJTMR *pTmr, TMR_EVENT *pEvent)
+{
+    _displayReserveQueueFill(pGpu);
+    return NV_OK;
+}
+
+//
+// Free every chunk held.  The caller excludes the other users of the reserve
+// (see Locking) and passes the RM API its locks allow.
+//
+static void
+_displayReserveFreeChunks(OBJGPU *pGpu, DisplayReserve *pReserve, RM_API *pRmApi)
+{
+    MemoryManager *pMemoryManager = GPU_GET_MEMORY_MANAGER(pGpu);
+    NvHandle       hChunk[DISPLAY_RESERVE_MAX_CHUNKS + 1];
+    NvU32          i;
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    portMemCopy(hChunk, sizeof(hChunk), pReserve->hChunk, sizeof(pReserve->hChunk));
+    portMemSet(pReserve->hChunk, 0, sizeof(pReserve->hChunk));
+    pReserve->heldSize = 0;
+    portSyncMutexRelease(pReserve->pMutex);
+
+    for (i = 0; i < NV_ARRAY_ELEMENTS(hChunk); i++)
+    {
+        if (hChunk[i] != 0)
+            pRmApi->Free(pRmApi, pMemoryManager->hClient, hChunk[i]);
+    }
+}
+
+//
+// Cut the reserve for the largest display surface, then allocate the
+// chunks not held, in order, until all are held or one is refused.  Runs with
+// the API lock held for writing and without the GPU lock, which
+// vidmemConstruct acquires only after PMA has allocated.
+//
+static void
+_displayReserveFillWorkItem(NvU32 gpuInstance, void *pArgs)
+{
+    OBJGPU         *pGpu = gpumgrGetGpu(gpuInstance);
+    DisplayReserve *pReserve;
+    MemoryManager  *pMemoryManager;
+    RM_API         *pRmApi = rmapiGetInterface(RMAPI_API_LOCK_INTERNAL);
+    OBJTMR         *pTmr;
+    NV_STATUS       status = NV_OK;
+    DisplaySurfaceMapIter it;
+    NvU64           scanoutSize = 0;
+    NvU64           size;
+    NvU64           chunkSize;
+    NvU64           heldBefore;
+    NvU32           numChunks;
+    NvU32           i;
+
+    if (pGpu == NULL)
+        return;
+
+    pReserve = _displayReserveGet(pGpu);
+    if ((pReserve == NULL) || !pReserve->bStarted)
+        return;
+
+    pMemoryManager = GPU_GET_MEMORY_MANAGER(pGpu);
+    pTmr = GPU_GET_TIMER(pGpu);
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    it = mapIterAll(&pReserve->surfaces);
+    while (mapIterNext(&it))
+        scanoutSize = NV_MAX(scanoutSize, it.pValue->size);
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if (scanoutSize == 0)
+        size = 0;
+    else if (pReserve->sizeOverride != 0)
+        size = pReserve->sizeOverride;
+    else
+        size = NV_ALIGN_UP64(DISPLAY_RESERVE_AUTO_SCANOUTS * scanoutSize +
+                             DISPLAY_RESERVE_AUTO_CURSOR_BYTES, 1ULL << 20);
+
+    chunkSize = NV_MAX(scanoutSize,
+                       NV_ALIGN_UP64(NV_DIV_AND_CEIL(size, DISPLAY_RESERVE_MAX_CHUNKS),
+                                     DISPLAY_RESERVE_CHUNK_ALIGN));
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    pReserve->scanoutSize = scanoutSize;
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if ((size != pReserve->size) || (chunkSize != pReserve->chunkSize))
+    {
+        _displayReserveFreeChunks(pGpu, pReserve, pRmApi);
+        pReserve->size          = size;
+        pReserve->chunkSize     = chunkSize;
+        pReserve->numFullChunks = (chunkSize != 0) ? (NvU32)(size / chunkSize) : 0;
+        pReserve->restSize      = size - (NvU64)pReserve->numFullChunks * chunkSize;
+        pReserve->backoffNs     = DISPLAY_RESERVE_BACKOFF_MIN_NS;
+
+        NV_PRINTF(LEVEL_INFO,
+                  "display reserve: %llu MiB for a %llu KiB scanout surface "
+                  "(%u x %llu KiB + %llu KiB)\n",
+                  size >> 20, scanoutSize >> 10, pReserve->numFullChunks,
+                  chunkSize >> 10, pReserve->restSize >> 10);
+    }
+
+    heldBefore = pReserve->heldSize;
+    numChunks = pReserve->numFullChunks + ((pReserve->restSize != 0) ? 1 : 0);
+
+    for (i = 0; (i < numChunks) && (status == NV_OK); i++)
+    {
+        NV_MEMORY_ALLOCATION_PARAMS allocParams = {0};
+        NvHandle hChunk = 0;
+
+        if (pReserve->hChunk[i] != 0)
+            continue;
+
+        // NVKMS's scanout request (NVKMS_KAPI_ALLOCATION_TYPE_SCANOUT), pitch layout.
+        allocParams.owner     = HEAP_OWNER_RM_CLIENT_GENERIC;
+        allocParams.type      = NVOS32_TYPE_PRIMARY;
+        allocParams.size      = _displayReserveChunkSize(pReserve, i);
+        allocParams.alignment = DISPLAY_RESERVE_SURFACE_ALIGNMENT;
+        allocParams.flags     = NVOS32_ALLOC_FLAGS_ALIGNMENT_FORCE |
+                                NVOS32_ALLOC_FLAGS_FORCE_MEM_GROWS_UP;
+        allocParams.attr      = DRF_DEF(OS32, _ATTR, _FORMAT, _PITCH) |
+                                DRF_DEF(OS32, _ATTR, _LOCATION, _VIDMEM) |
+                                DRF_DEF(OS32, _ATTR, _PHYSICALITY, _CONTIGUOUS);
+        allocParams.attr2     = DRF_DEF(OS32, _ATTR2, _GPU_CACHEABLE, _NO) |
+                                DRF_DEF(OS32, _ATTR2, _ISO, _YES);
+
+        status = pRmApi->Alloc(pRmApi, pMemoryManager->hClient, pMemoryManager->hDevice,
+                               &hChunk, NV01_MEMORY_LOCAL_USER,
+                               &allocParams, sizeof(allocParams));
+        if (status == NV_OK)
+        {
+            portSyncMutexAcquire(pReserve->pMutex);
+            pReserve->hChunk[i] = hChunk;
+            pReserve->heldSize += allocParams.size;
+            portSyncMutexRelease(pReserve->pMutex);
+        }
+    }
+
+    if (pReserve->heldSize == pReserve->size)
+    {
+        if (heldBefore != pReserve->heldSize)
+        {
+            NV_PRINTF(LEVEL_INFO, "display reserve: holds %llu MiB\n",
+                      pReserve->size >> 20);
+        }
+        pReserve->backoffNs = DISPLAY_RESERVE_BACKOFF_MIN_NS;
+        return;
+    }
+
+    NV_PRINTF(LEVEL_INFO,
+              "display reserve: holds %llu of %llu KiB (0x%x), next try in %llu s\n",
+              pReserve->heldSize >> 10, pReserve->size >> 10, status,
+              pReserve->backoffNs / (1000ULL * 1000 * 1000));
+
+    if (rmDeviceGpuLocksAcquire(pGpu, GPUS_LOCK_FLAGS_NONE, RM_LOCK_MODULES_MEM) == NV_OK)
+    {
+        if (!tmrEventOnList(pTmr, pReserve->pRefillEvent))
+            tmrEventScheduleRel(pTmr, pReserve->pRefillEvent, pReserve->backoffNs);
+        rmDeviceGpuLocksRelease(pGpu, GPUS_LOCK_FLAGS_NONE, NULL);
+    }
+    pReserve->backoffNs = NV_MIN(pReserve->backoffNs * 2, DISPLAY_RESERVE_BACKOFF_MAX_NS);
+}
+
+/*!
+ * Read the RmDisplayReserve registry keys and set up the reserve of pGpu.
+ * Called from memmgrStateInitLocked.
+ */
+void
+displayReserveInitGpu
+(
+    OBJGPU *pGpu
+)
+{
+    DisplayReserve *pReserve;
+    NvU32           enable = NV_REG_STR_RM_DISPLAY_RESERVE_DEFAULT;
+    NvU32           sizeMB = NV_REG_STR_RM_DISPLAY_RESERVE_SIZE_MB_AUTO;
+
+    NV_ASSERT_OR_RETURN_VOID(pGpu->gpuInstance < NV_MAX_DEVICES);
+
+    if ((osReadRegistryDword(pGpu, NV_REG_STR_RM_DISPLAY_RESERVE, &enable) != NV_OK) ||
+        (enable != NV_REG_STR_RM_DISPLAY_RESERVE_ENABLE))
+    {
+        return;
+    }
+    (void)osReadRegistryDword(pGpu, NV_REG_STR_RM_DISPLAY_RESERVE_SIZE_MB, &sizeMB);
+
+    pReserve = portMemAllocNonPaged(sizeof(*pReserve));
+    if (pReserve == NULL)
+    {
+        NV_PRINTF(LEVEL_ERROR, "display reserve: out of memory\n");
+        return;
+    }
+    portMemSet(pReserve, 0, sizeof(*pReserve));
+    pReserve->sizeOverride = (NvU64)sizeMB << 20;
+    pReserve->backoffNs = DISPLAY_RESERVE_BACKOFF_MIN_NS;
+
+    pReserve->pMutex = portSyncMutexCreate(portMemAllocatorGetGlobalNonPaged());
+    if (pReserve->pMutex == NULL)
+    {
+        NV_PRINTF(LEVEL_ERROR, "display reserve: failed to create mutex\n");
+        portMemFree(pReserve);
+        return;
+    }
+
+    if (tmrEventCreate(GPU_GET_TIMER(pGpu), &pReserve->pRefillEvent,
+                       _displayReserveRefillCallback, NULL, TMR_FLAGS_NONE) != NV_OK)
+    {
+        NV_PRINTF(LEVEL_ERROR, "display reserve: failed to create refill timer\n");
+        portSyncMutexDestroy(pReserve->pMutex);
+        portMemFree(pReserve);
+        return;
+    }
+
+    mapInit(&pReserve->surfaces, portMemAllocatorGetGlobalNonPaged());
+    g_pDisplayReserve[pGpu->gpuInstance] = pReserve;
+
+    NV_PRINTF(LEVEL_INFO, "display reserve: enabled, size %s\n",
+              (sizeMB == NV_REG_STR_RM_DISPLAY_RESERVE_SIZE_MB_AUTO) ? "automatic" : "fixed");
+}
+
+/*!
+ * Remove the reserve of pGpu.  Called from memmgrStateDestroy, after
+ * displayReserveStop() freed the chunks.
+ */
+void
+displayReserveRemoveGpu
+(
+    OBJGPU *pGpu
+)
+{
+    DisplayReserve *pReserve = _displayReserveGet(pGpu);
+
+    if (pReserve == NULL)
+        return;
+
+    g_pDisplayReserve[pGpu->gpuInstance] = NULL;
+
+    tmrEventDestroy(GPU_GET_TIMER(pGpu), pReserve->pRefillEvent);
+    mapDestroy(&pReserve->surfaces);
+    portSyncMutexDestroy(pReserve->pMutex);
+    portMemFree(pReserve);
+}
+
+/*!
+ * Start filling the reserve.  Called from memmgrStatePostLoad, at load and
+ * after every resume.
+ */
+void
+displayReserveStart
+(
+    OBJGPU *pGpu
+)
+{
+    DisplayReserve *pReserve = _displayReserveGet(pGpu);
+
+    if (pReserve == NULL)
+        return;
+
+    pReserve->bStarted = NV_TRUE;
+    pReserve->backoffNs = DISPLAY_RESERVE_BACKOFF_MIN_NS;
+    _displayReserveQueueFill(pGpu);
+}
+
+/*!
+ * Stop refilling and free every chunk.  Called from memmgrStatePreUnload,
+ * before every suspend and at teardown: the chunks hold no data to preserve.
+ */
+void
+displayReserveStop
+(
+    OBJGPU *pGpu
+)
+{
+    DisplayReserve *pReserve = _displayReserveGet(pGpu);
+
+    if (pReserve == NULL)
+        return;
+
+    pReserve->bStarted = NV_FALSE;
+    tmrEventCancel(GPU_GET_TIMER(pGpu), pReserve->pRefillEvent);
+
+    _displayReserveFreeChunks(pGpu, pReserve, rmapiGetInterface(RMAPI_GPU_LOCK_INTERNAL));
+    portSyncMutexAcquire(pReserve->pMutex);
+    pReserve->scanoutSize = 0;
+    portSyncMutexRelease(pReserve->pMutex);
+    pReserve->size = 0;
+    pReserve->chunkSize = 0;
+    pReserve->numFullChunks = 0;
+    pReserve->restSize = 0;
+}
+
+/*!
+ * Called by vidmemConstruct when an allocation failed with NV_ERR_NO_MEMORY.
+ * For a scanout surface of a kernel client (NVKMS: kernel privilege, ISO,
+ * physically contiguous, not NO_SCANOUT), free chunks that together cover the
+ * request: the rest chunk if it does alone, else one full chunk, else the rest
+ * chunk.  Returns NV_TRUE if memory was freed and the caller should retry the
+ * allocation.
+ */
+NvBool
+displayReserveRelease
+(
+    OBJGPU                            *pGpu,
+    NvHandle                           hClient,
+    RS_PRIV_LEVEL                      privLevel,
+    const NV_MEMORY_ALLOCATION_PARAMS *pAllocData
+)
+{
+    DisplayReserve *pReserve = _displayReserveGet(pGpu);
+    MemoryManager  *pMemoryManager = GPU_GET_MEMORY_MANAGER(pGpu);
+    RM_API         *pRmApi = rmapiGetInterface(RMAPI_API_LOCK_INTERNAL);
+    NvU64           released = 0;
+
+    if ((pReserve == NULL) ||
+        (privLevel < RS_PRIV_LEVEL_KERNEL) ||
+        !FLD_TEST_DRF(OS32, _ATTR, _PHYSICALITY, _CONTIGUOUS, pAllocData->attr) ||
+        !_displayReserveIsDisplaySurface(pGpu, hClient, pAllocData))
+    {
+        return NV_FALSE;
+    }
+
+    while (released < pAllocData->size)
+    {
+        NvU32    rest;
+        NvU32    pick = DISPLAY_RESERVE_MAX_CHUNKS + 1;
+        NvHandle hChunk;
+        NvU64    chunkSize;
+        NvU64    heldSize;
+        NvU32    i;
+
+        portSyncMutexAcquire(pReserve->pMutex);
+        rest = pReserve->numFullChunks;
+        if ((pReserve->hChunk[rest] != 0) &&
+            (pReserve->restSize >= pAllocData->size - released))
+        {
+            pick = rest;
+        }
+        else
+        {
+            for (i = rest; i > 0; i--)
+            {
+                if (pReserve->hChunk[i - 1] != 0)
+                {
+                    pick = i - 1;
+                    break;
+                }
+            }
+            if ((pick > DISPLAY_RESERVE_MAX_CHUNKS) && (pReserve->hChunk[rest] != 0))
+                pick = rest;
+        }
+
+        if (pick > DISPLAY_RESERVE_MAX_CHUNKS)
+        {
+            portSyncMutexRelease(pReserve->pMutex);
+            break;
+        }
+
+        hChunk = pReserve->hChunk[pick];
+        chunkSize = _displayReserveChunkSize(pReserve, pick);
+        pReserve->hChunk[pick] = 0;
+        pReserve->heldSize -= chunkSize;
+        heldSize = pReserve->heldSize;
+        portSyncMutexRelease(pReserve->pMutex);
+
+        pRmApi->Free(pRmApi, pMemoryManager->hClient, hChunk);
+        released += chunkSize;
+
+        NV_PRINTF(LEVEL_WARNING,
+                  "display reserve: released %llu KiB for a refused display allocation "
+                  "of %llu KiB, holds %llu of %llu KiB\n",
+                  chunkSize >> 10, pAllocData->size >> 10,
+                  heldSize >> 10, pReserve->size >> 10);
+    }
+
+    return (released != 0);
+}
+
+/*!
+ * Called by vidmemConstruct after an allocation succeeded.  Track display
+ * surfaces; one larger than the current cut starts a refill, which re-cuts
+ * the reserve.  bServed: displayReserveRelease() made room for it, so its
+ * free refills the reserve.
+ */
+void
+displayReserveNoteAlloc
+(
+    OBJGPU                            *pGpu,
+    NvHandle                           hClient,
+    const NV_MEMORY_ALLOCATION_PARAMS *pAllocData,
+    Memory                            *pMemory,
+    NvBool                             bServed
+)
+{
+    DisplayReserve *pReserve = _displayReserveGet(pGpu);
+    DisplaySurface *pSurface;
+    NvBool          bLarger = NV_FALSE;
+
+    if ((pReserve == NULL) ||
+        !_displayReserveIsDisplaySurface(pGpu, hClient, pAllocData))
+    {
+        return;
+    }
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    pSurface = mapInsertNew(&pReserve->surfaces, (NvU64)(NvUPtr)pMemory);
+    if (pSurface != NULL)
+    {
+        pSurface->size = pAllocData->size;
+        pSurface->bServed = bServed;
+        bLarger = (pAllocData->size > pReserve->scanoutSize);
+    }
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if (bLarger && pReserve->bStarted)
+        _displayReserveQueueFill(pGpu);
+}
+
+/*!
+ * Called by vidmemDestruct.  Stop tracking pMemory if it is a display
+ * surface, and refill the reserve if it made room for pMemory.
+ */
+void
+displayReserveNoteFree
+(
+    OBJGPU   *pGpu,
+    NvHandle  hClient,
+    Memory   *pMemory
+)
+{
+    DisplayReserve *pReserve = _displayReserveGet(pGpu);
+    MemoryManager  *pMemoryManager = GPU_GET_MEMORY_MANAGER(pGpu);
+    DisplaySurface *pSurface;
+    NvBool          bServed = NV_FALSE;
+
+    if ((pReserve == NULL) || (hClient == pMemoryManager->hClient))
+        return;
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    pSurface = mapFind(&pReserve->surfaces, (NvU64)(NvUPtr)pMemory);
+    if (pSurface != NULL)
+    {
+        bServed = pSurface->bServed;
+        mapRemove(&pReserve->surfaces, pSurface);
+    }
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if (bServed && pReserve->bStarted)
+        _displayReserveQueueFill(pGpu);
+}
