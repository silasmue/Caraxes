diff --git a/src/nvidia/interface/nvrm_registry.h b/src/nvidia/interface/nvrm_registry.h
index d6f4d93..f405326 100644
--- a/src/nvidia/interface/nvrm_registry.h
+++ b/src/nvidia/interface/nvrm_registry.h
@@ -3560,6 +3560,33 @@
 #define NV_REG_STR_MEMACCT_MODE_NO_OVERRIDE (0x00000003)
 #define NV_REG_STR_MEMACCT_FALLBACK_DEFAULT NV_REG_STR_MEMACCT_MODE_NO_OVERRIDE
 
+//
+// Type DWORD
+// Reserve video memory for the display (scanout) allocations of kernel clients
+// such as NVKMS. When such an allocation fails for lack of video memory, RM
+// frees reserved memory and retries it, so a process that fills the video
+// memory cannot leave the display without a surface. The reserve counts as
+// used video memory and refills once the memory is free again. It is cut into
+// chunks of the largest display surface (ISO video memory without NO_SCANOUT),
+// one scanout surface of the largest mode in use, and follows it through mode
+// changes and hotplug.
+// 0 - No reserve (default)
+// 1 - Reserve
+//
+#define NV_REG_STR_RM_DISPLAY_RESERVE                   "RmDisplayReserve"
+#define NV_REG_STR_RM_DISPLAY_RESERVE_DISABLE           (0x00000000)
+#define NV_REG_STR_RM_DISPLAY_RESERVE_ENABLE            (0x00000001)
+#define NV_REG_STR_RM_DISPLAY_RESERVE_DEFAULT           NV_REG_STR_RM_DISPLAY_RESERVE_DISABLE
+
+//
+// Type DWORD
+// Size of the display reserve (RmDisplayReserve) in MB.
+// 0 - Five scanout surfaces and four 256x256 cursors (default)
+// N - N MB
+//
+#define NV_REG_STR_RM_DISPLAY_RESERVE_SIZE_MB           "RmDisplayReserveSizeMB"
+#define NV_REG_STR_RM_DISPLAY_RESERVE_SIZE_MB_AUTO      (0x00000000)
+
 //
 // Type DWORD
 // Enable engine state load status logging.
