+/*
+ * Tell RM how much video memory to hold in reserve for the scanout surfaces
+ * of pDispEvo (NV0073_CTRL_CMD_SYSTEM_SET_DISPLAY_RESERVE), when that changed
+ * since the last request.  RM gives the reserve to a kernel client's scanout
+ * allocation that fails for lack of video memory, and takes such an
+ * allocation back into the reserve when it is freed.  If RM refuses the
+ * request, the reserve is released, and the same request is not repeated.
+ */
+static void SetDisplayReserve(NVDispEvoPtr pDispEvo,
+                              NvU64 reserveSize,
+                              NvU64 surfaceSize)
+{
+    NV0073_CTRL_SYSTEM_SET_DISPLAY_RESERVE_PARAMS params = { };
+    NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
+    NvU32 ret;
+
+    if ((pDevEvo->displayCommonHandle == 0) ||
+        ((pDispEvo->displayReserve.reserveSize == reserveSize) &&
+         (pDispEvo->displayReserve.surfaceSize == surfaceSize))) {
+        return;
+    }
+
+    pDispEvo->displayReserve.reserveSize = reserveSize;
+    pDispEvo->displayReserve.surfaceSize = surfaceSize;
+
+    params.subDeviceInstance = pDispEvo->displayOwner;
+    params.reserveSize = reserveSize;
+    params.surfaceSize = surfaceSize;
+
+    ret = nvRmApiControl(nvEvoGlobal.clientHandle,
+                         pDevEvo->displayCommonHandle,
+                         NV0073_CTRL_CMD_SYSTEM_SET_DISPLAY_RESERVE,
+                         &params, sizeof(params));
+    if (ret != NVOS_STATUS_SUCCESS) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                     "Failed to set the display memory reserve to %llu KiB (0x%x)",
+                     reserveSize >> 10, ret);
+
+        /* RM accepts a request of 0 whenever it takes the control. */
+        nvkms_memset(&params, 0, sizeof(params));
+        params.subDeviceInstance = pDispEvo->displayOwner;
+        nvRmApiControl(nvEvoGlobal.clientHandle,
+                       pDevEvo->displayCommonHandle,
+                       NV0073_CTRL_CMD_SYSTEM_SET_DISPLAY_RESERVE,
+                       &params, sizeof(params));
+    }
+}
+
+/*
+ * One XRGB8888 scanout surface of width x height as NVIDIA's GBM backend
+ * sizes it: the pitch in 64-byte units, the height in 128-line blocks, the
+ * whole rounded up to 64 KiB (0x870000 bytes at 1920x1080).
+ */
+static NvU64 ScanoutSurfaceSize(NvU32 width, NvU32 height)
+{
+    const NvU64 pitch = NV_ALIGN_UP64((NvU64)width * 4, 64);
+    const NvU64 lines = NV_ALIGN_UP64((NvU64)height, 128);
+
+    return NV_ALIGN_UP64(pitch * lines, 0x10000);
+}
+
+/*
+ * The size of the largest RM memory object bound to a layer of apiHead.
+ */
+static NvU64 BoundSurfaceSize(const NVDispEvoRec *pDispEvo, NvU32 apiHead)
+{
+    const NVDevEvoRec *pDevEvo = pDispEvo->pDevEvo;
+    NvU64 size = 0;
+    NvU32 layer;
+
+    for (layer = 0; layer < pDevEvo->apiHead[apiHead].numLayers; layer++) {
+        NVSurfaceEvoPtr pSurfaceEvos[NVKMS_MAX_EYES];
+        NvU8 eye;
+
+        nvApiHeadGetLayerSurfaceArray(pDispEvo, apiHead, layer, pSurfaceEvos);
+
+        FOR_ALL_EYES(eye) {
+            const NVSurfaceEvoRec *pSurfaceEvo = pSurfaceEvos[eye];
+            NvU8 plane;
+
+            if (pSurfaceEvo == NULL) {
+                continue;
+            }
+
+            FOR_ALL_VALID_PLANES(plane, pSurfaceEvo) {
+                size = NV_MAX(size, pSurfaceEvo->planes[plane].rmObjectSizeInBytes);
+            }
+        }
+    }
+
+    return size;
+}
+
+/*
+ * Request the video memory reserve for the scanout surfaces of the committed
+ * configuration, as the display_reserve_mib module parameter asks: per
+ * active head five scanout surfaces and four cursors of the maximum cursor
+ * size, or a fixed size while any head is active.  A head's scanout surface
+ * is the larger of an XRGB8888 surface of its ViewPortIn and the largest
+ * surface bound to one of its layers.  The five surfaces cover the largest
+ * peak of display allocations above an idle desktop measured with GNOME 46
+ * on one head (4.67 surfaces), and a compositor may hold four cursor images.
+ *
+ * Called after every successful modeset, and with growOnly after every
+ * flip: a flip that binds a larger surface grows the reserve, which shrinks
+ * again only at the next modeset.
+ */
+void nvRmUpdateDisplayReserve(NVDevEvoPtr pDevEvo, NvBool growOnly)
+{
+    const NvS32 reserveMib = nvkms_display_reserve_mib();
+    const NvU64 cursorSize = (NvU64)pDevEvo->cursorHal->caps.maxSize *
+                             pDevEvo->cursorHal->caps.maxSize * 4;
+    NVDispEvoPtr pDispEvo;
+    NvU32 dispIndex;
+
+    if (reserveMib == 0) {
+        return;
+    }
+
+    FOR_ALL_EVO_DISPLAYS(pDispEvo, dispIndex, pDevEvo) {
+        NvU64 reserveSize = 0;
+        NvU64 surfaceSize = 0;
+        NvU32 apiHead;
+
+        for (apiHead = 0; apiHead < pDevEvo->numApiHeads; apiHead++) {
+            const NVHwModeViewPortEvo *pViewPort;
+            NvU64 size;
+
+            if (!nvApiHeadIsActive(pDispEvo, apiHead)) {
+                continue;
+            }
+
+            pViewPort = &pDispEvo->apiHeadState[apiHead].timings.viewPort;
+            size = NV_MAX(ScanoutSurfaceSize(pViewPort->in.width, pViewPort->in.height),
+                          BoundSurfaceSize(pDispEvo, apiHead));
+
+            surfaceSize = NV_MAX(surfaceSize, size);
+            reserveSize += 5 * size + 4 * cursorSize;
+        }
+
+        if ((reserveMib > 0) && (surfaceSize != 0)) {
+            reserveSize = (NvU64)reserveMib << 20;
+        }
+
+        if (growOnly) {
+            reserveSize = NV_MAX(reserveSize, pDispEvo->displayReserve.reserveSize);
+            surfaceSize = NV_MAX(surfaceSize, pDispEvo->displayReserve.surfaceSize);
+        }
+
+        SetDisplayReserve(pDispEvo, reserveSize, surfaceSize);
+    }
+}
+
