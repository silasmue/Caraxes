+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+
+//
+// Display reserve.
+//
+// A scanout surface is physically contiguous video memory with no fallback.
+// When processes that size themselves to the free video memory (a game
+// sizing its pools to the Vulkan memory budget) have taken it all, the
+// display driver's next scanout allocation fails and the display stops.
+//
+// The display driver declares how much video memory to hold in reserve for
+// its scanout surfaces, and the size of its largest surface, with
+// NV0073_CTRL_CMD_SYSTEM_SET_DISPLAY_RESERVE; NVKMS derives both from the
+// committed modes of its heads.  RM holds the reserve as runs of PMA pages:
+// each full run covers one surface with the page size RM gives such a
+// surface, and one rest run holds the remainder.  The runs leave PMA's free
+// count, so the reserve counts as used video memory.
+//
+// When PMA refuses a scanout allocation of a kernel client (kernel privilege,
+// ISO, physically contiguous, not NO_SCANOUT) for lack of memory,
+// _vidmemPmaAllocate calls displayReserveRelease() to free runs that cover
+// it and retries.  Allocations through the RM API hold the API lock for
+// writing unless RmRoApiLock enables read-only allocations, so no other such
+// allocation takes the freed pages before the retry; UVM allocates from PMA
+// directly and may, and then the next run is released.
+//
+// A release schedules a refill one second later.  A refill that cannot fill
+// the reserve retries on a backoff of one second, doubling up to thirty.  A
+// new declaration re-cuts the reserve: the refill allocates the new runs
+// before it frees the old ones.
+//
+// Runs are never mapped or written.  PMA hands out zeroed pages when it
+// scrubs on free, so the runs are freed with PMA_FREE_SKIP_SCRUB; this also
+// keeps the scrubber, which is destroyed before memmgrStatePreUnload at
+// unload, out of the free.
+//
+// Locking: pMutex guards the fields below it in DisplayReserve and is never
+// held across a PMA call.  The refill runs as a work item with the API lock
+// held for writing and without the GPU lock, as PMA must not be entered
+// under the GPU lock.  displayReserveStop() runs with the GPU lock, possibly
+// without the API lock (GC6/RTD3 entry), and clears bStarted; the refill
+// checks bStarted after each PMA allocation and frees what it got once it is
+// clear.
+//
+
+#include "gpu/mem_mgr/display_reserve.h"
+#include "gpu/gpu.h"
+#include "gpu/mem_mgr/mem_mgr.h"
+#include "gpu/mem_mgr/heap.h"
+#include "gpu/mem_mgr/phys_mem_allocator/phys_mem_allocator.h"
+#include "gpu/timer/objtmr.h"
+#include "kernel/gpu/mig_mgr/kernel_mig_manager.h"
+#include "core/locks.h"
+#include "os/os.h"
+#include "resserv/rs_server.h"
+
+// At most this many full runs; a larger reserve makes each run cover more.
+#define DISPLAY_RESERVE_MAX_RUNS            64
+#define DISPLAY_RESERVE_RUN_ALIGN           0x10000ULL
+
+#define DISPLAY_RESERVE_REFILL_NS           (1ULL * 1000 * 1000 * 1000)
+#define DISPLAY_RESERVE_BACKOFF_MAX_NS      (30ULL * 1000 * 1000 * 1000)
+
+typedef struct
+{
+    NvU64 size;         // bytes the run covers
+    NvU64 pageSize;
+    NvU64 pageCount;
+    NvU64 base;         // physical address of the first page; 0 while not held
+} DisplayReserveRun;
+
+struct DisplayReserve
+{
+    TMR_EVENT          *pRefillEvent;
+    PORT_MUTEX         *pMutex;
+
+    // Declared by the display driver.
+    NvU64               reserveSize;
+    NvU64               surfaceSize;
+
+    // The runs, cut for cutReserveSize and cutSurfaceSize.  The last one is
+    // the rest run when its size is below the others'.
+    NvU64               cutReserveSize;
+    NvU64               cutSurfaceSize;
+    NvU32               numRuns;
+    DisplayReserveRun   runs[DISPLAY_RESERVE_MAX_RUNS + 1];
+    NvU64               heldBytes;      // PMA bytes of the runs held
+    NvU64               targetBytes;    // PMA bytes of all runs
+
+    NvU64               backoffNs;
+    NvBool              bStarted;
+};
+
+typedef struct DisplayReserve DisplayReserve;
+
+static PMA *
+_displayReserveGetPma(MemoryManager *pMemoryManager)
+{
+    return MEMORY_MANAGER_GET_HEAP(pMemoryManager)->pPmaObject;
+}
+
+//
+// The PMA page size RM gives a scanout allocation of this size: the one
+// memmgrDeterminePageSize() returns for NVKMS's request
+// (NVKMS_KAPI_ALLOCATION_TYPE_SCANOUT, pitch), raised to PMA's minimum as
+// _vidmemPmaAllocate() does.
+//
+static NvU64
+_displayReserveRunPageSize(MemoryManager *pMemoryManager, NvU64 size)
+{
+    NvU32 attr  = DRF_DEF(OS32, _ATTR, _FORMAT, _PITCH) |
+                  DRF_DEF(OS32, _ATTR, _LOCATION, _VIDMEM) |
+                  DRF_DEF(OS32, _ATTR, _PHYSICALITY, _CONTIGUOUS);
+    NvU32 attr2 = DRF_DEF(OS32, _ATTR2, _GPU_CACHEABLE, _NO) |
+                  DRF_DEF(OS32, _ATTR2, _ISO, _YES);
+    NvU64 pageSize;
+
+    pageSize = memmgrDeterminePageSize(pMemoryManager, pMemoryManager->hClient, size,
+                                       NVOS32_ATTR_FORMAT_PITCH,
+                                       NVOS32_ALLOC_FLAGS_ALIGNMENT_FORCE |
+                                       NVOS32_ALLOC_FLAGS_FORCE_MEM_GROWS_UP,
+                                       &attr, &attr2);
+
+    return NV_MAX(pageSize, RM_PAGE_SIZE_64K);
+}
+
+//
+// Cut runs for a reserve of reserveSize bytes and surfaces of surfaceSize
+// bytes: full runs of one surface each, or of more when that would take more
+// than DISPLAY_RESERVE_MAX_RUNS of them, and one rest run for the remainder.
+// Returns the number of runs.
+//
+static NvU32
+_displayReserveCut
+(
+    MemoryManager     *pMemoryManager,
+    NvU64              reserveSize,
+    NvU64              surfaceSize,
+    DisplayReserveRun *pRuns
+)
+{
+    NvU64 runSize;
+    NvU64 restSize;
+    NvU32 numFull;
+    NvU32 numRuns = 0;
+    NvU32 i;
+
+    if ((reserveSize == 0) || (surfaceSize == 0))
+        return 0;
+
+    runSize  = NV_MAX(surfaceSize,
+                      NV_ALIGN_UP64(NV_DIV_AND_CEIL(reserveSize, DISPLAY_RESERVE_MAX_RUNS),
+                                    DISPLAY_RESERVE_RUN_ALIGN));
+    numFull  = (NvU32)(reserveSize / runSize);
+    restSize = reserveSize - (NvU64)numFull * runSize;
+
+    for (i = 0; i < numFull + ((restSize != 0) ? 1 : 0); i++)
+    {
+        NvU64 size = (i < numFull) ? runSize : restSize;
+
+        pRuns[numRuns].size      = size;
+        pRuns[numRuns].pageSize  = _displayReserveRunPageSize(pMemoryManager, size);
+        pRuns[numRuns].pageCount = NV_DIV_AND_CEIL(size, pRuns[numRuns].pageSize);
+        pRuns[numRuns].base      = 0;
+        numRuns++;
+    }
+
+    return numRuns;
+}
+
+static NvU64
+_displayReserveRunBytes(const DisplayReserveRun *pRun)
+{
+    return pRun->pageCount * pRun->pageSize;
+}
+
+static NV_STATUS
+_displayReserveAllocRun(PMA *pPma, DisplayReserveRun *pRun)
+{
+    PMA_ALLOCATION_OPTIONS allocOptions = {0};
+
+    allocOptions.flags     = PMA_ALLOCATE_PINNED |
+                             PMA_ALLOCATE_CONTIGUOUS |
+                             PMA_ALLOCATE_FORCE_ALIGNMENT;
+    allocOptions.alignment = pRun->pageSize;
+
+    return pmaAllocatePages(pPma, pRun->pageCount, pRun->pageSize, &allocOptions, &pRun->base);
+}
+
+static void
+_displayReserveFreeRun(PMA *pPma, DisplayReserveRun *pRun)
+{
+    pmaFreePages(pPma, &pRun->base, 1, _displayReserveRunBytes(pRun), PMA_FREE_SKIP_SCRUB);
+    pRun->base = 0;
+}
+
+static void
+_displayReserveFreeRuns(PMA *pPma, DisplayReserveRun *pRuns, NvU32 numRuns)
+{
+    NvU32 i;
+
+    for (i = 0; i < numRuns; i++)
+    {
+        if (pRuns[i].base != 0)
+            _displayReserveFreeRun(pPma, &pRuns[i]);
+    }
+}
+
+//
+// (Re)arm the refill timer, which needs the GPU lock.  The refill work item
+// and _vidmemPmaAllocate(), the callers, do not hold it.
+//
+static void
+_displayReserveScheduleRefill(OBJGPU *pGpu, DisplayReserve *pReserve, NvU64 delayNs)
+{
+    OBJTMR    *pTmr = GPU_GET_TIMER(pGpu);
+    NvBool     bLockAcquired = NV_FALSE;
+    NV_STATUS  status;
+
+    if (!rmDeviceGpuLockIsOwner(pGpu->gpuInstance))
+    {
+        status = rmDeviceGpuLocksAcquire(pGpu, GPUS_LOCK_FLAGS_NONE, RM_LOCK_MODULES_MEM);
+        if (status != NV_OK)
+        {
+            NV_PRINTF(LEVEL_ERROR, "display reserve: cannot schedule a refill (0x%x)\n", status);
+            return;
+        }
+        bLockAcquired = NV_TRUE;
+    }
+
+    status = tmrEventScheduleRel(pTmr, pReserve->pRefillEvent, delayNs);
+    if (status != NV_OK)
+        NV_PRINTF(LEVEL_ERROR, "display reserve: cannot schedule a refill (0x%x)\n", status);
+
+    if (bLockAcquired)
+        rmDeviceGpuLocksRelease(pGpu, GPUS_LOCK_FLAGS_NONE, NULL);
+}
+
+static void _displayReserveRefillWorkItem(NvU32 gpuInstance, void *pArgs);
+
+static void
+_displayReserveQueueRefill(OBJGPU *pGpu)
+{
+    NV_STATUS status;
+
+    status = osQueueWorkItem(pGpu, _displayReserveRefillWorkItem, NULL,
+                             (OsQueueWorkItemFlags){
+                                 .bDontFreeParams = NV_TRUE,
+                                 .bDropOnUnloadQueueFlush = NV_TRUE,
+                                 .apiLock = WORKITEM_FLAGS_API_LOCK_READ_WRITE});
+    if (status != NV_OK)
+        NV_PRINTF(LEVEL_ERROR, "display reserve: cannot queue a refill (0x%x)\n", status);
+}
+
+static NV_STATUS
+_displayReserveRefillCallback(OBJGPU *pGpu, OBJTMR *pTmr, TMR_EVENT *pEvent)
+{
+    _displayReserveQueueRefill(pGpu);
+    return NV_OK;
+}
+
+//
+// Bring the runs to the declared cut and allocate the runs not held.
+//
+static void
+_displayReserveRefillWorkItem(NvU32 gpuInstance, void *pArgs)
+{
+    OBJGPU            *pGpu = gpumgrGetGpu(gpuInstance);
+    MemoryManager     *pMemoryManager;
+    DisplayReserve    *pReserve;
+    PMA               *pPma;
+    DisplayReserveRun  runs[DISPLAY_RESERVE_MAX_RUNS + 1];
+    NvU64              reserveSize;
+    NvU64              surfaceSize;
+    NvU64              heldBytes;
+    NvU64              targetBytes;
+    NvU32              numRuns;
+    NvU32              i;
+    NvBool             bStopped = NV_FALSE;
+    NV_STATUS          status = NV_OK;
+
+    if ((pGpu == NULL) || !gpuIsGpuFullPower(pGpu) || IS_MIG_ENABLED(pGpu))
+        return;
+
+    pMemoryManager = GPU_GET_MEMORY_MANAGER(pGpu);
+    pReserve = pMemoryManager->pDisplayReserve;
+    if ((pReserve == NULL) || !memmgrIsPmaInitialized(pMemoryManager))
+        return;
+
+    pPma = _displayReserveGetPma(pMemoryManager);
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    bStopped    = !pReserve->bStarted;
+    reserveSize = pReserve->reserveSize;
+    surfaceSize = pReserve->surfaceSize;
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if (bStopped)
+        return;
+
+    //
+    // A new declaration: allocate the new runs first, then swap them in and
+    // free the old ones, so the reserve is never empty in between.
+    //
+    if ((reserveSize != pReserve->cutReserveSize) || (surfaceSize != pReserve->cutSurfaceSize))
+    {
+        DisplayReserveRun oldRuns[DISPLAY_RESERVE_MAX_RUNS + 1];
+        NvU32             numOldRuns;
+
+        numRuns = _displayReserveCut(pMemoryManager, reserveSize, surfaceSize, runs);
+        for (i = 0; (i < numRuns) && (status == NV_OK); i++)
+            status = _displayReserveAllocRun(pPma, &runs[i]);
+
+        portSyncMutexAcquire(pReserve->pMutex);
+        bStopped = !pReserve->bStarted;
+        if (!bStopped)
+        {
+            portMemCopy(oldRuns, sizeof(oldRuns), pReserve->runs, sizeof(pReserve->runs));
+            numOldRuns = pReserve->numRuns;
+
+            portMemCopy(pReserve->runs, sizeof(pReserve->runs), runs, sizeof(runs));
+            pReserve->numRuns        = numRuns;
+            pReserve->cutReserveSize = reserveSize;
+            pReserve->cutSurfaceSize = surfaceSize;
+            pReserve->heldBytes      = 0;
+            pReserve->targetBytes    = 0;
+            for (i = 0; i < numRuns; i++)
+            {
+                pReserve->targetBytes += _displayReserveRunBytes(&runs[i]);
+                if (runs[i].base != 0)
+                    pReserve->heldBytes += _displayReserveRunBytes(&runs[i]);
+            }
+        }
+        portSyncMutexRelease(pReserve->pMutex);
+
+        if (bStopped)
+        {
+            _displayReserveFreeRuns(pPma, runs, numRuns);
+            return;
+        }
+        _displayReserveFreeRuns(pPma, oldRuns, numOldRuns);
+
+        NV_PRINTF(LEVEL_INFO,
+                  "display reserve: %llu KiB for %llu KiB scanout surfaces, %u runs, %llu KiB in PMA\n",
+                  reserveSize >> 10, surfaceSize >> 10, numRuns, pReserve->targetBytes >> 10);
+    }
+
+    // Allocate the runs not held.
+    status = NV_OK;
+    for (i = 0; (i < pReserve->numRuns) && (status == NV_OK) && !bStopped; i++)
+    {
+        DisplayReserveRun run;
+
+        if (pReserve->runs[i].base != 0)
+            continue;
+
+        run = pReserve->runs[i];
+        status = _displayReserveAllocRun(pPma, &run);
+        if (status != NV_OK)
+            break;
+
+        portSyncMutexAcquire(pReserve->pMutex);
+        bStopped = !pReserve->bStarted;
+        if (!bStopped)
+        {
+            pReserve->runs[i].base = run.base;
+            pReserve->heldBytes += _displayReserveRunBytes(&run);
+        }
+        portSyncMutexRelease(pReserve->pMutex);
+
+        if (bStopped)
+            _displayReserveFreeRun(pPma, &run);
+    }
+
+    if (bStopped)
+        return;
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    heldBytes   = pReserve->heldBytes;
+    targetBytes = pReserve->targetBytes;
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if (heldBytes == targetBytes)
+    {
+        NV_PRINTF(LEVEL_INFO, "display reserve: holds %llu KiB\n", heldBytes >> 10);
+        pReserve->backoffNs = DISPLAY_RESERVE_REFILL_NS;
+        return;
+    }
+
+    NV_PRINTF(LEVEL_INFO, "display reserve: holds %llu of %llu KiB (0x%x), next try in %llu s\n",
+              heldBytes >> 10, targetBytes >> 10, status,
+              pReserve->backoffNs / DISPLAY_RESERVE_REFILL_NS);
+
+    _displayReserveScheduleRefill(pGpu, pReserve, pReserve->backoffNs);
+    pReserve->backoffNs = NV_MIN(pReserve->backoffNs * 2, DISPLAY_RESERVE_BACKOFF_MAX_NS);
+}
+
+/*!
+ * Set up the display reserve of pGpu.  Called from memmgrStateInitLocked.
+ * Without PMA there is no reserve, and the display driver's declaration is
+ * refused.
+ */
+NV_STATUS
+displayReserveInit
+(
+    OBJGPU        *pGpu,
+    MemoryManager *pMemoryManager
+)
+{
+    DisplayReserve *pReserve;
+    NV_STATUS       status;
+
+    if (!memmgrIsPmaInitialized(pMemoryManager))
+        return NV_OK;
+
+    pReserve = portMemAllocNonPaged(sizeof(*pReserve));
+    if (pReserve == NULL)
+        return NV_ERR_NO_MEMORY;
+    portMemSet(pReserve, 0, sizeof(*pReserve));
+
+    pReserve->pMutex = portSyncMutexCreate(portMemAllocatorGetGlobalNonPaged());
+    if (pReserve->pMutex == NULL)
+    {
+        portMemFree(pReserve);
+        return NV_ERR_NO_MEMORY;
+    }
+
+    status = tmrEventCreate(GPU_GET_TIMER(pGpu), &pReserve->pRefillEvent,
+                            _displayReserveRefillCallback, NULL, TMR_FLAG_USE_OS_TIMER);
+    if (status != NV_OK)
+    {
+        portSyncMutexDestroy(pReserve->pMutex);
+        portMemFree(pReserve);
+        return status;
+    }
+
+    pReserve->backoffNs = DISPLAY_RESERVE_REFILL_NS;
+    pMemoryManager->pDisplayReserve = pReserve;
+
+    return NV_OK;
+}
+
+/*!
+ * Remove the display reserve of pGpu.  Called from memmgrStateDestroy, after
+ * displayReserveStop() freed the runs.
+ */
+void
+displayReserveDestroy
+(
+    OBJGPU        *pGpu,
+    MemoryManager *pMemoryManager
+)
+{
+    DisplayReserve *pReserve = pMemoryManager->pDisplayReserve;
+
+    if (pReserve == NULL)
+        return;
+
+    pMemoryManager->pDisplayReserve = NULL;
+
+    tmrEventDestroy(GPU_GET_TIMER(pGpu), pReserve->pRefillEvent);
+    portSyncMutexDestroy(pReserve->pMutex);
+    portMemFree(pReserve);
+}
+
+/*!
+ * Start holding the declared reserve.  Called from memmgrStatePostLoad: at
+ * load, after resume and after GC6/RTD3 exit.
+ */
+void
+displayReserveStart
+(
+    OBJGPU        *pGpu,
+    MemoryManager *pMemoryManager
+)
+{
+    DisplayReserve *pReserve = pMemoryManager->pDisplayReserve;
+    NvBool          bDeclared;
+
+    if (pReserve == NULL)
+        return;
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    pReserve->bStarted  = NV_TRUE;
+    pReserve->backoffNs = DISPLAY_RESERVE_REFILL_NS;
+    bDeclared = (pReserve->reserveSize != 0);
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if (bDeclared)
+        _displayReserveQueueRefill(pGpu);
+}
+
+/*!
+ * Free every run and stop refilling.  Called from memmgrStatePreUnload with
+ * the GPU lock: at unload, before suspend and at GC6/RTD3 entry.  The
+ * declaration is kept for displayReserveStart().
+ */
+void
+displayReserveStop
+(
+    OBJGPU        *pGpu,
+    MemoryManager *pMemoryManager
+)
+{
+    DisplayReserve    *pReserve = pMemoryManager->pDisplayReserve;
+    DisplayReserveRun  runs[DISPLAY_RESERVE_MAX_RUNS + 1];
+    NvU32              numRuns;
+
+    if (pReserve == NULL)
+        return;
+
+    tmrEventCancel(GPU_GET_TIMER(pGpu), pReserve->pRefillEvent);
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    pReserve->bStarted = NV_FALSE;
+    portMemCopy(runs, sizeof(runs), pReserve->runs, sizeof(pReserve->runs));
+    numRuns = pReserve->numRuns;
+    portMemSet(pReserve->runs, 0, sizeof(pReserve->runs));
+    pReserve->numRuns        = 0;
+    pReserve->cutReserveSize = 0;
+    pReserve->cutSurfaceSize = 0;
+    pReserve->heldBytes      = 0;
+    pReserve->targetBytes    = 0;
+    portSyncMutexRelease(pReserve->pMutex);
+
+    _displayReserveFreeRuns(_displayReserveGetPma(pMemoryManager), runs, numRuns);
+}
+
+/*!
+ * Record the display driver's declaration and re-cut the reserve in the
+ * background.  Called for NV0073_CTRL_CMD_SYSTEM_SET_DISPLAY_RESERVE.
+ */
+NV_STATUS
+displayReserveSetNeed
+(
+    OBJGPU        *pGpu,
+    MemoryManager *pMemoryManager,
+    NvU64          reserveSize,
+    NvU64          surfaceSize
+)
+{
+    DisplayReserve *pReserve = pMemoryManager->pDisplayReserve;
+    NvBool          bStarted;
+
+    if ((pReserve == NULL) || IS_MIG_ENABLED(pGpu))
+        return NV_ERR_NOT_SUPPORTED;
+
+    if ((reserveSize != 0) && (surfaceSize == 0))
+        return NV_ERR_INVALID_ARGUMENT;
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    pReserve->reserveSize = reserveSize;
+    pReserve->surfaceSize = (reserveSize != 0) ? surfaceSize : 0;
+    pReserve->backoffNs   = DISPLAY_RESERVE_REFILL_NS;
+    bStarted = pReserve->bStarted;
+    portSyncMutexRelease(pReserve->pMutex);
+
+    NV_PRINTF(LEVEL_INFO, "display reserve: declared %llu KiB for %llu KiB scanout surfaces\n",
+              reserveSize >> 10, surfaceSize >> 10);
+
+    if (bStarted)
+        _displayReserveQueueRefill(pGpu);
+
+    return NV_OK;
+}
+
+/*!
+ * Called by _vidmemPmaAllocate() when PMA refused an allocation of size
+ * bytes for lack of memory.  For a scanout allocation of a kernel client
+ * (kernel privilege, ISO, physically contiguous, not NO_SCANOUT), free runs
+ * that together cover it, the rest run first when it does alone, and
+ * schedule a refill.  Returns NV_TRUE if runs were freed and the caller
+ * should retry.
+ */
+NvBool
+displayReserveRelease
+(
+    OBJGPU                            *pGpu,
+    MemoryManager                     *pMemoryManager,
+    const NV_MEMORY_ALLOCATION_PARAMS *pAllocData,
+    NvU64                              size
+)
+{
+    DisplayReserve    *pReserve = pMemoryManager->pDisplayReserve;
+    CALL_CONTEXT      *pCallContext = resservGetTlsCallContext();
+    DisplayReserveRun  runs[DISPLAY_RESERVE_MAX_RUNS + 1];
+    NvU64              released = 0;
+    NvU64              heldBytes;
+    NvU64              targetBytes;
+    NvU32              numRuns = 0;
+    NvU32              i;
+
+    if ((pReserve == NULL) ||
+        (pCallContext == NULL) ||
+        (pCallContext->secInfo.privLevel < RS_PRIV_LEVEL_KERNEL) ||
+        !FLD_TEST_DRF(OS32, _ATTR2, _ISO, _YES, pAllocData->attr2) ||
+        !FLD_TEST_DRF(OS32, _ATTR, _PHYSICALITY, _CONTIGUOUS, pAllocData->attr) ||
+        ((pAllocData->flags & NVOS32_ALLOC_FLAGS_NO_SCANOUT) != 0))
+    {
+        return NV_FALSE;
+    }
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    while ((released < size) && (pReserve->numRuns != 0))
+    {
+        // The rest run is the last one when it is smaller than the others.
+        NvU32  rest     = pReserve->numRuns - 1;
+        NvBool bHasRest = (pReserve->numRuns > 1) &&
+                          (pReserve->runs[rest].size < pReserve->runs[0].size);
+        NvBool bRestHeld = bHasRest && (pReserve->runs[rest].base != 0);
+        NvU32  pick     = pReserve->numRuns;
+
+        if (bRestHeld &&
+            (_displayReserveRunBytes(&pReserve->runs[rest]) >= size - released))
+        {
+            pick = rest;
+        }
+        else
+        {
+            for (i = bHasRest ? rest : pReserve->numRuns; i > 0; i--)
+            {
+                if (pReserve->runs[i - 1].base != 0)
+                {
+                    pick = i - 1;
+                    break;
+                }
+            }
+            if ((pick == pReserve->numRuns) && bRestHeld)
+                pick = rest;
+        }
+
+        if (pick == pReserve->numRuns)
+            break;
+
+        runs[numRuns] = pReserve->runs[pick];
+        pReserve->runs[pick].base = 0;
+        pReserve->heldBytes -= _displayReserveRunBytes(&runs[numRuns]);
+        released += _displayReserveRunBytes(&runs[numRuns]);
+        numRuns++;
+    }
+    heldBytes   = pReserve->heldBytes;
+    targetBytes = pReserve->targetBytes;
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if (numRuns == 0)
+        return NV_FALSE;
+
+    _displayReserveFreeRuns(_displayReserveGetPma(pMemoryManager), runs, numRuns);
+
+    NV_PRINTF(LEVEL_WARNING,
+              "display reserve: released %llu KiB for a refused scanout allocation of %llu KiB, "
+              "holds %llu of %llu KiB\n",
+              released >> 10, size >> 10, heldBytes >> 10, targetBytes >> 10);
+
+    _displayReserveScheduleRefill(pGpu, pReserve, DISPLAY_RESERVE_REFILL_NS);
+
+    return NV_TRUE;
+}
