+/*!
+ * @brief Declare the video memory reserve for the display's scanout surfaces.
+ */
+NV_STATUS
+dispcmnCtrlCmdSystemSetDisplayReserve_IMPL
+(
+    DispCommon *pDispCommon,
+    NV0073_CTRL_SYSTEM_SET_DISPLAY_RESERVE_PARAMS *pParams
+)
+{
+    OBJGPU    *pGpu;
+    NV_STATUS  status;
+
+    // client gave us a subdevice #: get right pGpu for it
+    status = dispapiSetUnicastAndSynchronize_HAL(
