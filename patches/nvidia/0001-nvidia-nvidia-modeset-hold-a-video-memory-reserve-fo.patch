+/*
+ * NV0073_CTRL_CMD_SYSTEM_SET_DISPLAY_RESERVE
+ *
+ * This command declares how much video memory RM holds in reserve for the
+ * scanout surfaces of the display.  A scanout surface is physically
+ * contiguous video memory with no fallback, so an allocation for it that
+ * fails because processes took all free video memory leaves the display
+ * without a surface.  RM holds the reserve as video memory taken out of its
+ * allocator in pieces of surfaceSize, so each piece has the shape such an
+ * allocation needs.  When a kernel client's scanout allocation fails for
+ * lack of video memory, RM gives it a piece; when such an allocation is
+ * freed while the reserve lacks a piece of its shape, RM takes its memory
+ * back into the reserve.  A new declaration replaces the previous one; RM
+ * re-cuts the reserve and refills it in the background.  This command is
+ * only allowed for kernel clients.
+ *
+ *   subDeviceInstance
+ *     This parameter specifies the subdevice instance within the
+ *     NV04_DISPLAY_COMMON parent device to which the operation should be
+ *     directed.
+ *   reserveSize
+ *     The size of the reserve in bytes.  0 releases the reserve and is
+ *     always accepted.  Otherwise it must be at least surfaceSize and at
+ *     most the size of the video memory.
+ *   surfaceSize
+ *     The size in bytes of the largest scanout surface of the display.
+ *
+ * Possible status values returned are:
+ *   NV_OK
+ *   NV_ERR_INVALID_ARGUMENT
+ *   NV_ERR_NOT_SUPPORTED
+ */
+
+#define NV0073_CTRL_CMD_SYSTEM_SET_DISPLAY_RESERVE (0x730162U) /* finn: Evaluated from "(FINN_NV04_DISPLAY_COMMON_SYSTEM_INTERFACE_ID << 8) | NV0073_CTRL_SYSTEM_SET_DISPLAY_RESERVE_PARAMS_MESSAGE_ID" */
+
+#define NV0073_CTRL_SYSTEM_SET_DISPLAY_RESERVE_PARAMS_MESSAGE_ID (0x62U)
+
+typedef struct NV0073_CTRL_SYSTEM_SET_DISPLAY_RESERVE_PARAMS {
+    NvU32 subDeviceInstance;
+    NV_DECLARE_ALIGNED(NvU64 reserveSize, 8);
+    NV_DECLARE_ALIGNED(NvU64 surfaceSize, 8);
+} NV0073_CTRL_SYSTEM_SET_DISPLAY_RESERVE_PARAMS;
+
