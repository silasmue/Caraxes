+#include "nvos.h"
+
+struct MemoryManager;
+
+//
+// Video memory held in reserve for the display's scanout surfaces, as the
+// display driver declares it with NV0073_CTRL_CMD_SYSTEM_SET_DISPLAY_RESERVE.
+// See display_reserve.c.
+//
+
+NV_STATUS displayReserveInit(OBJGPU *pGpu, struct MemoryManager *pMemoryManager);
+void      displayReserveDestroy(OBJGPU *pGpu, struct MemoryManager *pMemoryManager);
+void      displayReserveStart(OBJGPU *pGpu, struct MemoryManager *pMemoryManager);
+void      displayReserveStop(OBJGPU *pGpu, struct MemoryManager *pMemoryManager);
+
+NV_STATUS displayReserveSetNeed(OBJGPU *pGpu, struct MemoryManager *pMemoryManager,
+                                NvU64 reserveSize, NvU64 surfaceSize);
+NvBool    displayReserveRelease(OBJGPU *pGpu, struct MemoryManager *pMemoryManager,
+                                const NV_MEMORY_ALLOCATION_PARAMS *pAllocData, NvU64 size);
+
+#endif // DISPLAY_RESERVE_H
