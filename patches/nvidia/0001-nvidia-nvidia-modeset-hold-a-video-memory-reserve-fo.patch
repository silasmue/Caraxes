diff --git a/src/nvidia/src/kernel/gpu/mem_mgr/display_reserve.c b/src/nvidia/src/kernel/gpu/mem_mgr/display_reserve.c
new file mode 100644
index 0000000..f1a4324
--- /dev/null
+++ b/src/nvidia/src/kernel/gpu/mem_mgr/display_reserve.c
@@ -0,0 +1,1072 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 Silas Müller <github@silasmueller.de>
+ * SPDX-License-Identifier: MIT
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the "Software"),
+ * to deal in the Software without restriction, including without limitation
+ * the rights to use, copy, modify, merge, publish, distribute, sublicense,
+ * and/or sell copies of the Software, and to permit persons to whom the
+ * Software is furnished to do so, subject to the following conditions:
+ *
+ * The above copyright notice and this permission notice shall be included in
+ * all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL
+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+
+
+//
+// Display reserve.
+//
+// A scanout surface is physically contiguous video memory with no fallback.
+// When processes that size themselves to the free video memory (a game
+// sizing its pools to the Vulkan memory budget) have taken it all, the
+// display driver's next scanout allocation fails and the display stops.
+//
+// The display driver declares how much video memory to hold in reserve for
+// its scanout surfaces, and the size of its largest surface, with
+// NV0073_CTRL_CMD_SYSTEM_SET_DISPLAY_RESERVE.  RM holds the reserve as runs
+// of PMA pages: each full run covers one surface with the page size RM gives
+// such a surface, and one rest run holds the remainder.  The runs leave
+// PMA's free count, so the reserve counts as used video memory.
+//
+// Serve.  When PMA refuses a scanout allocation of a kernel client
+// (displayReserveIsScanoutAllocation()) for lack of memory,
+// _vidmemPmaAllocate() calls displayReserveServe().  It frees the smallest
+// held run that covers the allocation and retries.  Allocations through the
+// RM API hold the API lock for writing unless RmRoApiLock enables read-only
+// allocations, so no other such allocation takes the freed pages before the
+// retry; UVM allocates from PMA directly and may, and then the next covering
+// run is freed.  An allocation that no single run covers is not served.
+//
+// Take back.  When such a scanout allocation is freed while the reserve
+// lacks a run of exactly its shape (page size and page count),
+// vidmemPmaFree() hands its pages to the reserve instead of to PMA.  The
+// pages never become free in between, so no other allocation can take them.
+//
+// Refill.  A served allocation schedules a refill one second later.  The
+// refill allocates the runs not held; one that falls short retries on a
+// backoff of one second, doubling up to thirty.
+//
+// Re-cut.  A new declaration cuts new runs.  Held runs with the page size
+// and page count of a new run move over.  The others become old runs, which
+// serve like runs and are freed once the new runs hold enough without them.
+//
+// Scrubbing.  PMA scrubs pages when they are freed and reports allocations
+// as zeroed (PMA_ALLOCATE_RESULT_IS_ZERO).  A run the reserve allocated is
+// never mapped or written, so it is freed with PMA_FREE_SKIP_SCRUB.  A run
+// taken back holds the freed surface's contents and is freed without that
+// flag, so PMA scrubs it as it would have at the original free.
+//
+// Lifecycle.  displayReserveStart() runs from memmgrStatePostLoad().
+// displayReserveStop() runs from memmgrStatePreUnload(), which keeps the
+// runs over suspend and GC6/RTD3 and frees them at unload, and from
+// memmgrDestroyInternalChannels(), which frees them at unload before the
+// scrubber is destroyed.
+//
+// Locking.  pMutex guards the fields below it in DisplayReserve and is never
+// held across a PMA call.  The refill runs as a work item with the API lock
+// held for writing and without the GPU lock, as PMA must not be entered for
+// an allocation under the GPU lock; refills therefore never run
+// concurrently, and only the refill re-cuts.  displayReserveStop() may run
+// without the API lock (GC6/RTD3 entry): it advances the generation, and the
+// refill commits nothing and frees what it allocated once the generation
+// changed.
+//
+
+#include "gpu/mem_mgr/display_reserve.h"
+#include "gpu/gpu.h"
+#include "gpu/mem_mgr/mem_mgr.h"
+#include "gpu/mem_mgr/heap.h"
+#include "gpu/timer/objtmr.h"
+#include "kernel/gpu/mig_mgr/kernel_mig_manager.h"
+#include "core/locks.h"
+#include "os/os.h"
+#include "resserv/rs_server.h"
+
+// At most this many full runs; a larger reserve makes each run cover more.
+#define DISPLAY_RESERVE_MAX_RUNS            64
+#define DISPLAY_RESERVE_RUN_ALIGN           0x10000ULL
+
+#define DISPLAY_RESERVE_REFILL_NS           (1ULL * 1000 * 1000 * 1000)
+#define DISPLAY_RESERVE_BACKOFF_MAX_NS      (30ULL * 1000 * 1000 * 1000)
+
+//
+// The PMA allocation flags of pages the reserve takes back: pinned,
+// contiguous pages of the default regions that PMA scrubs when they are
+// freed, as the reserve's own runs.
+//
+#define DISPLAY_RESERVE_TAKE_FLAGS          (PMA_ALLOCATE_PINNED |                \
+                                             PMA_ALLOCATE_CONTIGUOUS |            \
+                                             PMA_ALLOCATE_FORCE_ALIGNMENT |       \
+                                             PMA_ALLOCATE_SPECIFY_ADDRESS_RANGE | \
+                                             PMA_ALLOCATE_REVERSE_ALLOC)
+
+typedef struct
+{
+    NvU64  size;        // bytes of surface the run covers
+    NvU64  pageSize;
+    NvU64  pageCount;
+    NvU64  base;        // physical address of the first page, while held
+    NvBool bHeld;
+    NvBool bTaken;      // taken back from a freed allocation: scrub when freed
+} DisplayReserveRun;
+
+struct DisplayReserve
+{
+    TMR_EVENT          *pRefillEvent;
+    PORT_MUTEX         *pMutex;
+
+    // Declared by the display driver.
+    NvU64               reserveSize;
+    NvU64               surfaceSize;
+
+    // The runs, cut for cutReserveSize and cutSurfaceSize: the full runs,
+    // then the rest run if there is a remainder.
+    NvU64               cutReserveSize;
+    NvU64               cutSurfaceSize;
+    DisplayReserveRun  *pRuns;
+    NvU32               numRuns;
+    NvU64               heldBytes;      // PMA bytes of the runs held
+    NvU64               targetBytes;    // PMA bytes of all runs
+
+    // Held runs of earlier cuts.
+    DisplayReserveRun  *pOldRuns;
+    NvU32               numOldRuns;
+    NvU64               oldBytes;       // PMA bytes of the old runs
+
+    NvU64               backoffNs;
+    NvU32               generation;     // advanced by displayReserveStop()
+    NvBool              bStarted;
+};
+
+typedef struct DisplayReserve DisplayReserve;
+
+static PMA *
+_displayReserveGetPma(MemoryManager *pMemoryManager)
+{
+    return MEMORY_MANAGER_GET_HEAP(pMemoryManager)->pPmaObject;
+}
+
+//
+// The PMA page size RM gives a scanout allocation of this size: the one
+// memmgrDeterminePageSize() returns for NVKMS's request
+// (NVKMS_KAPI_ALLOCATION_TYPE_SCANOUT, pitch), raised to PMA's minimum as
+// _vidmemPmaAllocate() does.
+//
+static NvU64
+_displayReserveRunPageSize(MemoryManager *pMemoryManager, NvU64 size)
+{
+    NvU32 attr  = DRF_DEF(OS32, _ATTR, _FORMAT, _PITCH) |
+                  DRF_DEF(OS32, _ATTR, _LOCATION, _VIDMEM) |
+                  DRF_DEF(OS32, _ATTR, _PHYSICALITY, _CONTIGUOUS);
+    NvU32 attr2 = DRF_DEF(OS32, _ATTR2, _GPU_CACHEABLE, _NO) |
+                  DRF_DEF(OS32, _ATTR2, _ISO, _YES);
+    NvU64 pageSize;
+
+    pageSize = memmgrDeterminePageSize(pMemoryManager, pMemoryManager->hClient, size,
+                                       NVOS32_ATTR_FORMAT_PITCH,
+                                       NVOS32_ALLOC_FLAGS_ALIGNMENT_FORCE |
+                                       NVOS32_ALLOC_FLAGS_FORCE_MEM_GROWS_UP,
+                                       &attr, &attr2);
+
+    return NV_MAX(pageSize, RM_PAGE_SIZE_64K);
+}
+
+//
+// Cut runs for a reserve of reserveSize bytes and surfaces of surfaceSize
+// bytes into pRuns (DISPLAY_RESERVE_MAX_RUNS + 1 entries): full runs of one
+// surface each, or of more when that would take more than
+// DISPLAY_RESERVE_MAX_RUNS of them, and one rest run for the remainder.
+// Returns the number of runs.
+//
+static NvU32
+_displayReserveCut
+(
+    MemoryManager     *pMemoryManager,
+    NvU64              reserveSize,
+    NvU64              surfaceSize,
+    DisplayReserveRun *pRuns
+)
+{
+    NvU64 runSize;
+    NvU64 restSize;
+    NvU32 numFull;
+    NvU32 numRuns = 0;
+    NvU32 i;
+
+    if ((reserveSize == 0) || (surfaceSize == 0))
+        return 0;
+
+    runSize  = NV_MAX(surfaceSize,
+                      NV_ALIGN_UP64(NV_DIV_AND_CEIL(reserveSize, DISPLAY_RESERVE_MAX_RUNS),
+                                    DISPLAY_RESERVE_RUN_ALIGN));
+    numFull  = (NvU32)(reserveSize / runSize);
+    restSize = reserveSize - (NvU64)numFull * runSize;
+
+    for (i = 0; i < numFull + ((restSize != 0) ? 1 : 0); i++)
+    {
+        NvU64 size = (i < numFull) ? runSize : restSize;
+
+        portMemSet(&pRuns[numRuns], 0, sizeof(pRuns[numRuns]));
+        pRuns[numRuns].size      = size;
+        pRuns[numRuns].pageSize  = _displayReserveRunPageSize(pMemoryManager, size);
+        pRuns[numRuns].pageCount = NV_DIV_AND_CEIL(size, pRuns[numRuns].pageSize);
+        numRuns++;
+    }
+
+    return numRuns;
+}
+
+static NvU64
+_displayReserveRunBytes(const DisplayReserveRun *pRun)
+{
+    return pRun->pageCount * pRun->pageSize;
+}
+
+static NV_STATUS
+_displayReserveAllocRun(PMA *pPma, DisplayReserveRun *pRun)
+{
+    PMA_ALLOCATION_OPTIONS allocOptions = {0};
+    NV_STATUS              status;
+
+    allocOptions.flags     = PMA_ALLOCATE_PINNED |
+                             PMA_ALLOCATE_CONTIGUOUS |
+                             PMA_ALLOCATE_FORCE_ALIGNMENT;
+    allocOptions.alignment = pRun->pageSize;
+
+    status = pmaAllocatePages(pPma, pRun->pageCount, pRun->pageSize, &allocOptions, &pRun->base);
+    pRun->bHeld  = (status == NV_OK);
+    pRun->bTaken = NV_FALSE;
+
+    return status;
+}
+
+static void
+_displayReserveFreeRun(PMA *pPma, DisplayReserveRun *pRun)
+{
+    pmaFreePages(pPma, &pRun->base, 1, _displayReserveRunBytes(pRun),
+                 pRun->bTaken ? 0 : PMA_FREE_SKIP_SCRUB);
+    pRun->bHeld = NV_FALSE;
+}
+
+//
+// Detach an old run to free: any when the runs are all held, else one the
+// runs hold enough without.  Called with pMutex held.
+//
+static NvBool
+_displayReserveDetachOldRun(DisplayReserve *pReserve, DisplayReserveRun *pRun)
+{
+    NvU32 i;
+
+    for (i = pReserve->numOldRuns; i > 0; i--)
+    {
+        NvU64 bytes = _displayReserveRunBytes(&pReserve->pOldRuns[i - 1]);
+
+        if (pReserve->heldBytes + pReserve->oldBytes - bytes >= pReserve->targetBytes)
+        {
+            *pRun = pReserve->pOldRuns[i - 1];
+            pReserve->pOldRuns[i - 1] = pReserve->pOldRuns[pReserve->numOldRuns - 1];
+            pReserve->numOldRuns--;
+            pReserve->oldBytes -= bytes;
+            return NV_TRUE;
+        }
+    }
+
+    return NV_FALSE;
+}
+
+//
+// Detach the smallest held run, old or new, whose pages can hold pageCount
+// pages of pageSize with pAllocOptions' alignment and range.  Of equal ones
+// it prefers a run not taken back, which needs no scrubbing, then an old
+// run.  Called with pMutex held.
+//
+static NvBool
+_displayReserveDetachCoveringRun
+(
+    DisplayReserve               *pReserve,
+    NvU64                         pageCount,
+    NvU64                         pageSize,
+    const PMA_ALLOCATION_OPTIONS *pAllocOptions,
+    DisplayReserveRun            *pRun
+)
+{
+    const NvU64 size      = pageCount * pageSize;
+    const NvU64 alignment = (pAllocOptions->flags & PMA_ALLOCATE_FORCE_ALIGNMENT) ?
+                            NV_MAX(pAllocOptions->alignment, pageSize) : pageSize;
+    NvU32       numAll    = pReserve->numOldRuns + pReserve->numRuns;
+    NvU32       pick      = numAll;
+    NvU32       i;
+
+    for (i = 0; i < numAll; i++)
+    {
+        const DisplayReserveRun *pCand = (i < pReserve->numOldRuns) ?
+                                         &pReserve->pOldRuns[i] :
+                                         &pReserve->pRuns[i - pReserve->numOldRuns];
+        const DisplayReserveRun *pPick;
+        NvU64                    start = NV_ALIGN_UP64(pCand->base, alignment);
+        NvU64                    bytes = _displayReserveRunBytes(pCand);
+
+        if (!pCand->bHeld || (start + size > pCand->base + bytes))
+            continue;
+
+        if ((pAllocOptions->flags & PMA_ALLOCATE_SPECIFY_ADDRESS_RANGE) &&
+            ((start < pAllocOptions->physBegin) || (start + size - 1 > pAllocOptions->physEnd)))
+        {
+            continue;
+        }
+
+        if (pick == numAll)
+        {
+            pick = i;
+            continue;
+        }
+
+        pPick = (pick < pReserve->numOldRuns) ? &pReserve->pOldRuns[pick] :
+                                                &pReserve->pRuns[pick - pReserve->numOldRuns];
+        if ((bytes < _displayReserveRunBytes(pPick)) ||
+            ((bytes == _displayReserveRunBytes(pPick)) && pPick->bTaken && !pCand->bTaken))
+        {
+            pick = i;
+        }
+    }
+
+    if (pick == numAll)
+        return NV_FALSE;
+
+    if (pick < pReserve->numOldRuns)
+    {
+        *pRun = pReserve->pOldRuns[pick];
+        pReserve->pOldRuns[pick] = pReserve->pOldRuns[pReserve->numOldRuns - 1];
+        pReserve->numOldRuns--;
+        pReserve->oldBytes -= _displayReserveRunBytes(pRun);
+    }
+    else
+    {
+        *pRun = pReserve->pRuns[pick - pReserve->numOldRuns];
+        pReserve->pRuns[pick - pReserve->numOldRuns].bHeld = NV_FALSE;
+        pReserve->heldBytes -= _displayReserveRunBytes(pRun);
+    }
+
+    return NV_TRUE;
+}
+
+//
+// (Re)arm the refill timer, which needs the GPU lock.  The refill work item
+// and _vidmemPmaAllocate(), the callers, do not hold it.
+//
+static void
+_displayReserveScheduleRefill(OBJGPU *pGpu, DisplayReserve *pReserve, NvU64 delayNs)
+{
+    OBJTMR    *pTmr = GPU_GET_TIMER(pGpu);
+    NvBool     bLockAcquired = NV_FALSE;
+    NV_STATUS  status;
+
+    if (!rmDeviceGpuLockIsOwner(pGpu->gpuInstance))
+    {
+        status = rmDeviceGpuLocksAcquire(pGpu, GPUS_LOCK_FLAGS_NONE, RM_LOCK_MODULES_MEM);
+        if (status != NV_OK)
+        {
+            NV_PRINTF(LEVEL_ERROR, "display reserve: cannot schedule a refill (0x%x)\n", status);
+            return;
+        }
+        bLockAcquired = NV_TRUE;
+    }
+
+    status = tmrEventScheduleRel(pTmr, pReserve->pRefillEvent, delayNs);
+    if (status != NV_OK)
+        NV_PRINTF(LEVEL_ERROR, "display reserve: cannot schedule a refill (0x%x)\n", status);
+
+    if (bLockAcquired)
+        rmDeviceGpuLocksRelease(pGpu, GPUS_LOCK_FLAGS_NONE, NULL);
+}
+
+static void _displayReserveRefillWorkItem(NvU32 gpuInstance, void *pArgs);
+
+static void
+_displayReserveQueueRefill(OBJGPU *pGpu)
+{
+    NV_STATUS status;
+
+    status = osQueueWorkItem(pGpu, _displayReserveRefillWorkItem, NULL,
+                             (OsQueueWorkItemFlags){
+                                 .bDontFreeParams = NV_TRUE,
+                                 .bDropOnUnloadQueueFlush = NV_TRUE,
+                                 .apiLock = WORKITEM_FLAGS_API_LOCK_READ_WRITE});
+    if (status != NV_OK)
+        NV_PRINTF(LEVEL_ERROR, "display reserve: cannot queue a refill (0x%x)\n", status);
+}
+
+static NV_STATUS
+_displayReserveRefillCallback(OBJGPU *pGpu, OBJTMR *pTmr, TMR_EVENT *pEvent)
+{
+    _displayReserveQueueRefill(pGpu);
+    return NV_OK;
+}
+
+//
+// Cut the runs for reserveSize and surfaceSize.  Held runs with a new run's
+// page size and page count move over; the other held runs become old runs.
+//
+static NV_STATUS
+_displayReserveRecut
+(
+    MemoryManager  *pMemoryManager,
+    DisplayReserve *pReserve,
+    NvU32           generation,
+    NvU64           reserveSize,
+    NvU64           surfaceSize
+)
+{
+    DisplayReserveRun *pRuns;
+    DisplayReserveRun *pOldRuns = NULL;
+    DisplayReserveRun *pPrevRuns;
+    DisplayReserveRun *pPrevOldRuns;
+    NvU32              numRuns;
+    NvU32              numOldRuns = 0;
+    NvU32              numPrev;
+    NvU32              i;
+    NvU32              j;
+
+    pRuns = portMemAllocNonPaged(sizeof(*pRuns) * (DISPLAY_RESERVE_MAX_RUNS + 1));
+    if (pRuns == NULL)
+        return NV_ERR_NO_MEMORY;
+    numRuns = _displayReserveCut(pMemoryManager, reserveSize, surfaceSize, pRuns);
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    if (!pReserve->bStarted || (pReserve->generation != generation))
+    {
+        portSyncMutexRelease(pReserve->pMutex);
+        portMemFree(pRuns);
+        return NV_ERR_INVALID_STATE;
+    }
+
+    numPrev = pReserve->numOldRuns + pReserve->numRuns;
+    if (numPrev != 0)
+    {
+        pOldRuns = portMemAllocNonPaged(sizeof(*pOldRuns) * numPrev);
+        if (pOldRuns == NULL)
+        {
+            portSyncMutexRelease(pReserve->pMutex);
+            portMemFree(pRuns);
+            return NV_ERR_NO_MEMORY;
+        }
+    }
+
+    for (i = 0; i < numPrev; i++)
+    {
+        const DisplayReserveRun *pPrev = (i < pReserve->numOldRuns) ?
+                                         &pReserve->pOldRuns[i] :
+                                         &pReserve->pRuns[i - pReserve->numOldRuns];
+
+        if (!pPrev->bHeld)
+            continue;
+
+        for (j = 0; j < numRuns; j++)
+        {
+            if (!pRuns[j].bHeld &&
+                (pRuns[j].pageSize == pPrev->pageSize) &&
+                (pRuns[j].pageCount == pPrev->pageCount))
+            {
+                pRuns[j].base   = pPrev->base;
+                pRuns[j].bHeld  = NV_TRUE;
+                pRuns[j].bTaken = pPrev->bTaken;
+                break;
+            }
+        }
+
+        if (j == numRuns)
+            pOldRuns[numOldRuns++] = *pPrev;
+    }
+
+    pPrevRuns    = pReserve->pRuns;
+    pPrevOldRuns = pReserve->pOldRuns;
+
+    pReserve->pRuns          = pRuns;
+    pReserve->numRuns        = numRuns;
+    pReserve->cutReserveSize = reserveSize;
+    pReserve->cutSurfaceSize = surfaceSize;
+    pReserve->pOldRuns       = pOldRuns;
+    pReserve->numOldRuns     = numOldRuns;
+    pReserve->heldBytes      = 0;
+    pReserve->targetBytes    = 0;
+    pReserve->oldBytes       = 0;
+    for (i = 0; i < numRuns; i++)
+    {
+        pReserve->targetBytes += _displayReserveRunBytes(&pRuns[i]);
+        if (pRuns[i].bHeld)
+            pReserve->heldBytes += _displayReserveRunBytes(&pRuns[i]);
+    }
+    for (i = 0; i < numOldRuns; i++)
+        pReserve->oldBytes += _displayReserveRunBytes(&pOldRuns[i]);
+    portSyncMutexRelease(pReserve->pMutex);
+
+    portMemFree(pPrevRuns);
+    portMemFree(pPrevOldRuns);
+
+    NV_PRINTF(LEVEL_INFO,
+              "display reserve: %llu KiB for %llu KiB scanout surfaces, %u runs, %llu KiB in PMA\n",
+              reserveSize >> 10, surfaceSize >> 10, numRuns, pReserve->targetBytes >> 10);
+
+    return NV_OK;
+}
+
+//
+// Allocate the runs not held, one at a time, and free the old runs the runs
+// hold enough without.  Returns the status of the last allocation.
+//
+static NV_STATUS
+_displayReserveFill(DisplayReserve *pReserve, PMA *pPma, NvU32 generation)
+{
+    NV_STATUS status = NV_OK;
+
+    for (;;)
+    {
+        DisplayReserveRun run;
+        NvBool            bCurrent;
+        NvBool            bOld = NV_FALSE;
+        NvBool            bMissing = NV_FALSE;
+        NvBool            bCommitted = NV_FALSE;
+        NvU32             i;
+
+        portSyncMutexAcquire(pReserve->pMutex);
+        bCurrent = pReserve->bStarted && (pReserve->generation == generation);
+        if (bCurrent)
+            bOld = _displayReserveDetachOldRun(pReserve, &run);
+        for (i = 0; bCurrent && !bOld && (i < pReserve->numRuns); i++)
+        {
+            if (!pReserve->pRuns[i].bHeld)
+            {
+                run = pReserve->pRuns[i];
+                bMissing = NV_TRUE;
+                break;
+            }
+        }
+        portSyncMutexRelease(pReserve->pMutex);
+
+        if (bOld)
+        {
+            _displayReserveFreeRun(pPma, &run);
+            continue;
+        }
+
+        if (!bCurrent)
+            return NV_ERR_INVALID_STATE;
+
+        if (!bMissing)
+            return status;
+
+        status = _displayReserveAllocRun(pPma, &run);
+        if (status != NV_OK)
+            return status;
+
+        portSyncMutexAcquire(pReserve->pMutex);
+        bCurrent = pReserve->bStarted && (pReserve->generation == generation);
+        if (bCurrent && !pReserve->pRuns[i].bHeld)
+        {
+            pReserve->pRuns[i] = run;
+            pReserve->heldBytes += _displayReserveRunBytes(&run);
+            bCommitted = NV_TRUE;
+        }
+        portSyncMutexRelease(pReserve->pMutex);
+
+        // Stopped meanwhile, or the run was taken back meanwhile.
+        if (!bCommitted)
+        {
+            _displayReserveFreeRun(pPma, &run);
+            if (!bCurrent)
+                return NV_ERR_INVALID_STATE;
+        }
+    }
+}
+
+//
+// Bring the runs to the declared cut, allocate the runs not held and free
+// the old runs no longer needed.
+//
+static void
+_displayReserveRefillWorkItem(NvU32 gpuInstance, void *pArgs)
+{
+    OBJGPU         *pGpu = gpumgrGetGpu(gpuInstance);
+    MemoryManager  *pMemoryManager;
+    DisplayReserve *pReserve;
+    NvU64           reserveSize;
+    NvU64           surfaceSize;
+    NvU64           heldBytes;
+    NvU64           targetBytes;
+    NvU64           oldBytes;
+    NvU64           backoffNs;
+    NvU32           generation;
+    NvBool          bRecut;
+    NvBool          bCurrent;
+    NV_STATUS       status = NV_OK;
+
+    if ((pGpu == NULL) || !gpuIsGpuFullPower(pGpu))
+        return;
+
+    pMemoryManager = GPU_GET_MEMORY_MANAGER(pGpu);
+    pReserve = pMemoryManager->pDisplayReserve;
+    if ((pReserve == NULL) || !memmgrIsPmaInitialized(pMemoryManager))
+        return;
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    bCurrent    = pReserve->bStarted;
+    generation  = pReserve->generation;
+    // With MIG enabled the reserve holds nothing.
+    reserveSize = IS_MIG_ENABLED(pGpu) ? 0 : pReserve->reserveSize;
+    surfaceSize = IS_MIG_ENABLED(pGpu) ? 0 : pReserve->surfaceSize;
+    bRecut      = (reserveSize != pReserve->cutReserveSize) ||
+                  (surfaceSize != pReserve->cutSurfaceSize);
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if (!bCurrent)
+        return;
+
+    if (bRecut)
+    {
+        status = _displayReserveRecut(pMemoryManager, pReserve, generation,
+                                      reserveSize, surfaceSize);
+        if (status == NV_ERR_INVALID_STATE)
+            return;
+        if (status != NV_OK)
+            NV_PRINTF(LEVEL_ERROR, "display reserve: cannot re-cut (0x%x)\n", status);
+    }
+
+    status = _displayReserveFill(pReserve, _displayReserveGetPma(pMemoryManager), generation);
+    if (status == NV_ERR_INVALID_STATE)
+        return;
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    heldBytes   = pReserve->heldBytes;
+    targetBytes = pReserve->targetBytes;
+    oldBytes    = pReserve->oldBytes;
+    backoffNs   = pReserve->backoffNs;
+    pReserve->backoffNs = (heldBytes == targetBytes) ? DISPLAY_RESERVE_REFILL_NS :
+                          NV_MIN(backoffNs * 2, DISPLAY_RESERVE_BACKOFF_MAX_NS);
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if (heldBytes == targetBytes)
+    {
+        NV_PRINTF(LEVEL_INFO, "display reserve: holds %llu KiB\n", heldBytes >> 10);
+        return;
+    }
+
+    NV_PRINTF(LEVEL_INFO,
+              "display reserve: holds %llu of %llu KiB and %llu KiB of old runs (0x%x), "
+              "next try in %llu s\n",
+              heldBytes >> 10, targetBytes >> 10, oldBytes >> 10, status,
+              backoffNs / DISPLAY_RESERVE_REFILL_NS);
+
+    _displayReserveScheduleRefill(pGpu, pReserve, backoffNs);
+}
+
+/*!
+ * Set up the display reserve of pGpu.  Called from memmgrStateInitLocked.
+ * Without PMA there is no reserve, and the display driver's declaration is
+ * refused.
+ */
+NV_STATUS
+displayReserveInit
+(
+    OBJGPU        *pGpu,
+    MemoryManager *pMemoryManager
+)
+{
+    DisplayReserve *pReserve;
+    NV_STATUS       status;
+
+    if (!memmgrIsPmaInitialized(pMemoryManager))
+        return NV_OK;
+
+    pReserve = portMemAllocNonPaged(sizeof(*pReserve));
+    if (pReserve == NULL)
+        return NV_ERR_NO_MEMORY;
+    portMemSet(pReserve, 0, sizeof(*pReserve));
+
+    pReserve->pMutex = portSyncMutexCreate(portMemAllocatorGetGlobalNonPaged());
+    if (pReserve->pMutex == NULL)
+    {
+        portMemFree(pReserve);
+        return NV_ERR_NO_MEMORY;
+    }
+
+    status = tmrEventCreate(GPU_GET_TIMER(pGpu), &pReserve->pRefillEvent,
+                            _displayReserveRefillCallback, NULL, TMR_FLAG_USE_OS_TIMER);
+    if (status != NV_OK)
+    {
+        portSyncMutexDestroy(pReserve->pMutex);
+        portMemFree(pReserve);
+        return status;
+    }
+
+    pReserve->backoffNs = DISPLAY_RESERVE_REFILL_NS;
+    pMemoryManager->pDisplayReserve = pReserve;
+
+    return NV_OK;
+}
+
+/*!
+ * Remove the display reserve of pGpu.  Called from memmgrStateDestroy; the
+ * runs were freed by displayReserveStop() at unload.
+ */
+void
+displayReserveDestroy
+(
+    OBJGPU        *pGpu,
+    MemoryManager *pMemoryManager
+)
+{
+    DisplayReserve *pReserve = pMemoryManager->pDisplayReserve;
+
+    if (pReserve == NULL)
+        return;
+
+    NV_ASSERT((pReserve->heldBytes == 0) && (pReserve->numOldRuns == 0));
+
+    pMemoryManager->pDisplayReserve = NULL;
+
+    tmrEventDestroy(GPU_GET_TIMER(pGpu), pReserve->pRefillEvent);
+    portSyncMutexDestroy(pReserve->pMutex);
+    portMemFree(pReserve->pRuns);
+    portMemFree(pReserve->pOldRuns);
+    portMemFree(pReserve);
+}
+
+/*!
+ * Start holding the declared reserve.  Called from memmgrStatePostLoad: at
+ * load, after resume and after GC6/RTD3 exit.
+ */
+void
+displayReserveStart
+(
+    OBJGPU        *pGpu,
+    MemoryManager *pMemoryManager
+)
+{
+    DisplayReserve *pReserve = pMemoryManager->pDisplayReserve;
+    NvBool          bDeclared;
+
+    if (pReserve == NULL)
+        return;
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    pReserve->bStarted  = NV_TRUE;
+    pReserve->backoffNs = DISPLAY_RESERVE_REFILL_NS;
+    bDeclared = (pReserve->reserveSize != 0) || (pReserve->numRuns != 0) ||
+                (pReserve->numOldRuns != 0);
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if (bDeclared)
+        _displayReserveQueueRefill(pGpu);
+}
+
+/*!
+ * Stop refilling and taking back, and with bFree free every run.  Called
+ * with the GPU lock from memmgrStatePreUnload, freeing only at unload (the
+ * runs stay held over suspend and GC6/RTD3), and from
+ * memmgrDestroyInternalChannels at unload, before the scrubber that taken
+ * runs need is destroyed.  The declaration is kept for displayReserveStart().
+ */
+void
+displayReserveStop
+(
+    OBJGPU        *pGpu,
+    MemoryManager *pMemoryManager,
+    NvBool         bFree
+)
+{
+    DisplayReserve    *pReserve = pMemoryManager->pDisplayReserve;
+    DisplayReserveRun *pRuns;
+    DisplayReserveRun *pOldRuns;
+    PMA               *pPma;
+
+    if (pReserve == NULL)
+        return;
+
+    tmrEventCancel(GPU_GET_TIMER(pGpu), pReserve->pRefillEvent);
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    pReserve->bStarted = NV_FALSE;
+    pReserve->generation++;
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if (!bFree)
+        return;
+
+    pPma = _displayReserveGetPma(pMemoryManager);
+
+    // One run at a time, so the mutex is never held across pmaFreePages().
+    for (;;)
+    {
+        DisplayReserveRun run;
+        NvBool            bPicked = NV_FALSE;
+        NvU32             i;
+
+        portSyncMutexAcquire(pReserve->pMutex);
+        if (pReserve->numOldRuns != 0)
+        {
+            run = pReserve->pOldRuns[--pReserve->numOldRuns];
+            pReserve->oldBytes -= _displayReserveRunBytes(&run);
+            bPicked = NV_TRUE;
+        }
+        for (i = 0; !bPicked && (i < pReserve->numRuns); i++)
+        {
+            if (pReserve->pRuns[i].bHeld)
+            {
+                run = pReserve->pRuns[i];
+                pReserve->pRuns[i].bHeld = NV_FALSE;
+                pReserve->heldBytes -= _displayReserveRunBytes(&run);
+                bPicked = NV_TRUE;
+            }
+        }
+        portSyncMutexRelease(pReserve->pMutex);
+
+        if (!bPicked)
+            break;
+
+        _displayReserveFreeRun(pPma, &run);
+    }
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    pRuns    = pReserve->pRuns;
+    pOldRuns = pReserve->pOldRuns;
+    pReserve->pRuns          = NULL;
+    pReserve->numRuns        = 0;
+    pReserve->pOldRuns       = NULL;
+    pReserve->cutReserveSize = 0;
+    pReserve->cutSurfaceSize = 0;
+    pReserve->targetBytes    = 0;
+    portSyncMutexRelease(pReserve->pMutex);
+
+    portMemFree(pRuns);
+    portMemFree(pOldRuns);
+}
+
+/*!
+ * Record the display driver's declaration and re-cut the reserve in the
+ * background.  Called for NV0073_CTRL_CMD_SYSTEM_SET_DISPLAY_RESERVE.  A
+ * declaration of 0 is always accepted.
+ */
+NV_STATUS
+displayReserveSetNeed
+(
+    OBJGPU        *pGpu,
+    MemoryManager *pMemoryManager,
+    NvU64          reserveSize,
+    NvU64          surfaceSize
+)
+{
+    DisplayReserve *pReserve = pMemoryManager->pDisplayReserve;
+    NvBool          bStarted;
+
+    if (reserveSize != 0)
+    {
+        NvU64 totalBytes;
+
+        if ((pReserve == NULL) || IS_MIG_ENABLED(pGpu))
+            return NV_ERR_NOT_SUPPORTED;
+
+        pmaGetTotalMemory(_displayReserveGetPma(pMemoryManager), &totalBytes);
+        if ((surfaceSize == 0) || (surfaceSize > reserveSize) || (reserveSize > totalBytes))
+            return NV_ERR_INVALID_ARGUMENT;
+    }
+    else if (pReserve == NULL)
+    {
+        return NV_OK;
+    }
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    pReserve->reserveSize = reserveSize;
+    pReserve->surfaceSize = (reserveSize != 0) ? surfaceSize : 0;
+    pReserve->backoffNs   = DISPLAY_RESERVE_REFILL_NS;
+    bStarted = pReserve->bStarted;
+    portSyncMutexRelease(pReserve->pMutex);
+
+    NV_PRINTF(LEVEL_INFO, "display reserve: declared %llu KiB for %llu KiB scanout surfaces\n",
+              reserveSize >> 10, surfaceSize >> 10);
+
+    if (bStarted)
+        _displayReserveQueueRefill(pGpu);
+
+    return NV_OK;
+}
+
+/*!
+ * Whether an allocation is a scanout allocation of a kernel client: kernel
+ * privilege, ISO, physically contiguous, not NO_SCANOUT.  The reserve serves
+ * these and takes them back when they are freed.
+ */
+NvBool
+displayReserveIsScanoutAllocation
+(
+    const NV_MEMORY_ALLOCATION_PARAMS *pAllocData
+)
+{
+    CALL_CONTEXT *pCallContext = resservGetTlsCallContext();
+
+    return (pCallContext != NULL) &&
+           (pCallContext->secInfo.privLevel >= RS_PRIV_LEVEL_KERNEL) &&
+           FLD_TEST_DRF(OS32, _ATTR2, _ISO, _YES, pAllocData->attr2) &&
+           FLD_TEST_DRF(OS32, _ATTR, _PHYSICALITY, _CONTIGUOUS, pAllocData->attr) &&
+           ((pAllocData->flags & NVOS32_ALLOC_FLAGS_NO_SCANOUT) == 0);
+}
+
+/*!
+ * Called by _vidmemPmaAllocate() when PMA refused a contiguous allocation
+ * of pageCount pages of pageSize for lack of memory.  For a scanout
+ * allocation of a kernel client, free the smallest held run that covers it
+ * and retry, until the retry succeeds or no held run covers it, and
+ * schedule a refill.  Returns the status of the last attempt.
+ */
+NV_STATUS
+displayReserveServe
+(
+    OBJGPU                            *pGpu,
+    MemoryManager                     *pMemoryManager,
+    const NV_MEMORY_ALLOCATION_PARAMS *pAllocData,
+    PMA                               *pPma,
+    NvU64                              pageCount,
+    NvU64                              pageSize,
+    PMA_ALLOCATION_OPTIONS            *pAllocOptions,
+    NvU64                             *pPages
+)
+{
+    DisplayReserve *pReserve = pMemoryManager->pDisplayReserve;
+    const NvU64     size = pageCount * pageSize;
+    NvU64           released = 0;
+    NvU64           holdBytes;
+    NvU64           targetBytes;
+    NV_STATUS       status = NV_ERR_NO_MEMORY;
+
+    if ((pReserve == NULL) || (pPma != _displayReserveGetPma(pMemoryManager)) ||
+        !displayReserveIsScanoutAllocation(pAllocData))
+    {
+        return NV_ERR_NO_MEMORY;
+    }
+
+    do
+    {
+        DisplayReserveRun run;
+        NvBool            bPicked;
+
+        portSyncMutexAcquire(pReserve->pMutex);
+        bPicked = _displayReserveDetachCoveringRun(pReserve, pageCount, pageSize, pAllocOptions,
+                                                   &run);
+        portSyncMutexRelease(pReserve->pMutex);
+
+        if (!bPicked)
+            break;
+
+        _displayReserveFreeRun(pPma, &run);
+        released += _displayReserveRunBytes(&run);
+
+        status = pmaAllocatePages(pPma, pageCount, pageSize, pAllocOptions, pPages);
+    } while (status == NV_ERR_NO_MEMORY);
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    holdBytes   = pReserve->heldBytes + pReserve->oldBytes;
+    targetBytes = pReserve->targetBytes;
+    if (released != 0)
+        pReserve->backoffNs = DISPLAY_RESERVE_REFILL_NS;
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if (released == 0)
+    {
+        if (targetBytes != 0)
+        {
+            NV_PRINTF(LEVEL_WARNING,
+                      "display reserve: no held run covers a refused scanout allocation of %llu KiB, "
+                      "holds %llu of %llu KiB\n",
+                      size >> 10, holdBytes >> 10, targetBytes >> 10);
+        }
+        return NV_ERR_NO_MEMORY;
+    }
+
+    if (status == NV_OK)
+    {
+        NV_PRINTF(LEVEL_WARNING,
+                  "display reserve: released %llu KiB for a refused scanout allocation of %llu KiB, "
+                  "holds %llu of %llu KiB\n",
+                  released >> 10, size >> 10, holdBytes >> 10, targetBytes >> 10);
+    }
+    else
+    {
+        NV_PRINTF(LEVEL_WARNING,
+                  "display reserve: released %llu KiB for a refused scanout allocation of %llu KiB, "
+                  "which still failed (0x%x), holds %llu of %llu KiB\n",
+                  released >> 10, size >> 10, status, holdBytes >> 10, targetBytes >> 10);
+    }
+
+    _displayReserveScheduleRefill(pGpu, pReserve, DISPLAY_RESERVE_REFILL_NS);
+
+    return status;
+}
+
+/*!
+ * Called by vidmemPmaFree() for a freed allocation that
+ * displayReserveIsScanoutAllocation() matched.  If the reserve is started
+ * and lacks a run of the allocation's page size and page count, the run
+ * takes the allocation's pages, and the caller must not free them.
+ */
+NvBool
+displayReserveTake
+(
+    OBJGPU                      *pGpu,
+    MemoryManager               *pMemoryManager,
+    PMA                         *pPma,
+    const struct PMA_ALLOC_INFO *pPmaAllocInfo
+)
+{
+    DisplayReserve *pReserve = pMemoryManager->pDisplayReserve;
+    NvBool          bTaken = NV_FALSE;
+    NvU64           holdBytes;
+    NvU64           targetBytes;
+    NvU32           i;
+
+    if ((pReserve == NULL) || (pPma != _displayReserveGetPma(pMemoryManager)) ||
+        !pPmaAllocInfo->bContig ||
+        ((pPmaAllocInfo->flags & ~DISPLAY_RESERVE_TAKE_FLAGS) != 0))
+    {
+        return NV_FALSE;
+    }
+
+    portSyncMutexAcquire(pReserve->pMutex);
+    for (i = 0; pReserve->bStarted && (i < pReserve->numRuns); i++)
+    {
+        DisplayReserveRun *pRun = &pReserve->pRuns[i];
+
+        if (!pRun->bHeld &&
+            (pRun->pageSize == pPmaAllocInfo->pageSize) &&
+            (pRun->pageCount == pPmaAllocInfo->pageCount))
+        {
+            pRun->base   = pPmaAllocInfo->pageArray[0];
+            pRun->bHeld  = NV_TRUE;
+            pRun->bTaken = NV_TRUE;
+            pReserve->heldBytes += _displayReserveRunBytes(pRun);
+            bTaken = NV_TRUE;
+            break;
+        }
+    }
+    holdBytes   = pReserve->heldBytes + pReserve->oldBytes;
+    targetBytes = pReserve->targetBytes;
+    portSyncMutexRelease(pReserve->pMutex);
+
+    if (bTaken)
+    {
+        NV_PRINTF(LEVEL_INFO,
+                  "display reserve: took back a freed scanout allocation of %llu KiB, "
+                  "holds %llu of %llu KiB\n",
+                  (pPmaAllocInfo->pageCount * pPmaAllocInfo->pageSize) >> 10,
+                  holdBytes >> 10, targetBytes >> 10);
+    }
+
+    return bTaken;
+}
