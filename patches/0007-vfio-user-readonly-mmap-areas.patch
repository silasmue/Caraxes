+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct MmapSection {
+    offset: u64,
+    size: u64,
+    readonly: bool,
+}
+
+fn mmap_sections(
+    region: u32,
+    sparse: &[vfio_region_sparse_mmap_area],
+    requested: &[(u32, u64, u64)],
+) -> Result<Vec<MmapSection>, String> {
+    let page = get_page_size();
+    let mut sparse_sorted = sparse.to_vec();
+    sparse_sorted.sort_unstable_by_key(|area| area.offset);
+    for (index, area) in sparse_sorted.iter().enumerate() {
+        let _end = area
+            .offset
+            .checked_add(area.size)
+            .ok_or_else(|| format!("region {region} sparse mmap area overflows"))?;
+        if area.size == 0 {
+            return Err(format!("region {region} sparse mmap area is empty"));
+        }
+        if index > 0 {
+            let previous = &sparse_sorted[index - 1];
+            let previous_end = previous
+                .offset
+                .checked_add(previous.size)
+                .ok_or_else(|| format!("region {region} sparse mmap area overflows"))?;
+            if area.offset < previous_end {
+                return Err(format!(
+                    "region {region} sparse mmap areas overlap at {:#x}",
+                    area.offset
+                ));
+            }
+        }
+    }
+    let mut ro: Vec<_> = requested
+        .iter()
+        .filter(|a| a.0 == region)
+        .map(|a| (a.1, a.2))
+        .collect();
+    ro.sort_unstable();
+    for pair in ro.windows(2) {
+        let first_end = pair[0]
+            .0
+            .checked_add(pair[0].1)
+            .ok_or_else(|| format!("region {region} read-only area overflows"))?;
+        if pair[1].0 < first_end {
+            return Err(format!(
+                "region {region} read-only areas overlap at {:#x}",
+                pair[1].0
+            ));
+        }
+    }
+    for &(offset, size) in &ro {
+        let end = offset
+            .checked_add(size)
+            .ok_or_else(|| format!("region {region} read-only area overflows"))?;
+        if size == 0 || offset % page != 0 || size % page != 0 {
+            return Err(format!(
+                "region {region} read-only area {offset:#x}+{size:#x} is not page aligned"
+            ));
+        }
+        if !sparse_sorted
+            .iter()
+            .any(|a| a.offset <= offset && a.offset.checked_add(a.size).is_some_and(|e| end <= e))
+        {
+            return Err(format!(
+                "region {region} read-only area {offset:#x}+{size:#x} is outside its sparse mmap areas"
+            ));
+        }
+    }
+    let mut out = Vec::new();
+    for area in &sparse_sorted {
+        let end = area
+            .offset
+            .checked_add(area.size)
+            .ok_or_else(|| format!("region {region} sparse mmap area overflows"))?;
+        let mut cursor = area.offset;
+        for &(offset, size) in ro.iter().filter(|(o, _)| area.offset <= *o && *o < end) {
+            if cursor < offset {
+                out.push(MmapSection {
+                    offset: cursor,
+                    size: offset - cursor,
+                    readonly: false,
+                });
+            }
+            out.push(MmapSection {
+                offset,
+                size,
+                readonly: true,
+            });
+            cursor = offset + size;
+        }
+        if cursor < end {
+            out.push(MmapSection {
+                offset: cursor,
+                size: end - cursor,
+                readonly: false,
+            });
+        }
+    }
+    Ok(out)
 }
 
