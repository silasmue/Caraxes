+struct ReadonlyMmapAreaList(Vec<UserDeviceReadonlyMmapArea>);
+
+impl FromStr for ReadonlyMmapAreaList {
+    type Err = String;
+
+    fn from_str(s: &str) -> result::Result<Self, Self::Err> {
+        let number = |s: &str| {
+            let s = s.trim();
+            match s.strip_prefix("0x").or_else(|| s.strip_prefix("0X")) {
+                Some(hex) => u64::from_str_radix(hex, 16),
+                None => s.parse(),
+            }
+            .map_err(|_| format!("invalid number {s:?}"))
+        };
+        let areas = s
+            .trim()
+            .trim_start_matches('[')
+            .trim_end_matches(']')
+            .split(',')
+            .map(|entry| {
+                let f = entry
+                    .split(':')
+                    .map(number)
+                    .collect::<result::Result<Vec<_>, _>>()?;
+                match f[..] {
+                    [region, offset, size] if u32::try_from(region).is_ok() && size != 0 => {
+                        Ok(UserDeviceReadonlyMmapArea {
+                            region: region as u32,
+                            offset,
+                            size,
+                        })
+                    }
+                    [_, _, 0] => Err("read-only mmap area size must not be zero".into()),
+                    _ => Err(format!("{entry:?} is not <region>:<offset>:<size>")),
+                }
+            })
+            .collect::<result::Result<Vec<_>, _>>()?;
+        for (i, a) in areas.iter().enumerate() {
+            let end = a
+                .offset
+                .checked_add(a.size)
+                .ok_or_else(|| format!("area {i} overflows"))?;
+            for (j, b) in areas[..i].iter().enumerate() {
+                let b_end = b
+                    .offset
+                    .checked_add(b.size)
+                    .ok_or_else(|| format!("area {j} overflows"))?;
+                if a.region == b.region && a.offset < b_end && b.offset < end {
+                    return Err(format!("areas {j} and {i} overlap"));
+                }
+            }
+        }
+        Ok(Self(areas))
+    }
+}
